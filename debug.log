 = 0; i < s.length(); i++) {\\n\\n            if(s.charAt(i) == \' \') {\\n\\n                for(int j = i - 1; j >= st; j--) {\\n                    str.append(s.charAt(j));\\n                }\\n\\n                str.append(\' \');\\n                st = i + 1;\\n            }\\n        }\\n\\n        for(int i = s.length() - 1; i >= st; i--) {\\n            str.append(s.charAt(i));\\n        }\\n\\n        return str.toString();\\n    }\\n}","compare_result":"11111111111111111111111111111","title_slug":"reverse-words-in-a-string-iii","has_notes":false,"flag_type":1,"frontend_id":300},{"id":2002072845,"question_id":557,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778668929,"status":10,"status_display":"Accepted","runtime":"284 ms","url":"/submissions/detail/2002072845/","is_pending":"Not Pending","title":"Reverse Words in a String III","memory":"48.5 MB","code":"class Solution {\\n    public String reverseWords(String s) {\\n         int st = 0;\\n        String str = \\"\\";\\n        for(int i=0;i<s.length();i++) {\\n            if(s.charAt(i)==\' \') {\\n                for(int j=i-1;j>=st;j--) {\\n                    str+= s.charAt(j);\\n                }\\n                str += \' \';\\n                st = i+1;\\n            }\\n        }\\n        int i = s.length()-1;\\n        while(i>=0) {\\n            if(s.charAt(i)==\' \') {\\n                break;\\n            }\\n            str += s.charAt(i);\\n            i--;\\n        }\\n        return str;\\n    }\\n}","compare_result":"11111111111111111111111111111","title_slug":"reverse-words-in-a-string-iii","has_notes":false,"flag_type":1,"frontend_id":299},{"id":2002051403,"question_id":1651,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778666868,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2002051403/","is_pending":"Not Pending","title":"Shuffle String","memory":"45.3 MB","code"