detail/2032042645/","is_pending":"Not Pending","title":"4Sum","memory":"45.9 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public List<List<Integer>> fourSum(int[] nums, int target) {\\n\\n        List<List<Integer>> ans = new ArrayList<>();\\n        int n = nums.length;\\n\\n        Arrays.sort(nums);\\n\\n        for (int i = 0; i < n - 3; i++) {\\n\\n            if (i > 0 && nums[i] == nums[i - 1])\\n                continue;\\n\\n            for (int j = i + 1; j < n - 2; j++) {\\n\\n                if (j > i + 1 && nums[j] == nums[j - 1])\\n                    continue;\\n\\n                int p = j + 1;\\n                int q = n - 1;\\n\\n                while (p < q) {\\n\\n                    long sum = (long) nums[i]\\n                             + nums[j]\\n                             + nums[p]\\n                             + nums[q];\\n\\n                    if (sum < target) {\\n                        p++;\\n                    } else if (sum > target) {\\n                        q--;\\n                    } else {\\n\\n                        ans.add(Arrays.asList(\\n                                nums[i],\\n                                nums[j],\\n                                nums[p],\\n                                nums[q]\\n                        ));\\n\\n                        p++;\\n                        q--;\\n\\n                        while (p < q && nums[p] == nums[p - 1])\\n                            p++;\\n\\n                        while (p < q && nums[q] == nums[q + 1])\\n                            q--;\\n                    }\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"4sum","has_notes":false,"flag_type":1,"frontend_id":430},{"id":2031431531,"question_id":59,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781330942,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2031431531/","is_pending":"Not Pending","title":"Spiral Matrix II","memory":"43.2 MB","code":"class Solution {\\n    public int[][] generateMatrix(int n) {\\n        int mat[][] = new int[n][n];\\n        int left = 0,right=n-1;\\n        int top = 0,bottom=n-1;\\n        int num = 1;\\n        while(left<=right&&top<=bottom) {\\n            for(int i=left;i<=right;i++) {\\n                mat[top][i] = num++;\\n            }\\n            top++;\\n\\n            for(int i=top;i<=bottom;i++) {\\n                mat[i][right] = num++;\\n            }\\n            right--;\\n\\n            if(top<=bottom) {\\n\\t\\t\\t\\tfor(int i=right;i>=left;i--) {\\n                    mat[bottom][i] = num++;\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tbottom--;\\n\\t\\t\\tif(left<=right) {\\n\\t\\t\\t\\tfor(int i=bottom;i>=top;i--) {\\n                    mat[i][left] = num++;\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n            left++;\\n        }\\n        return mat;\\n    }\\n}","compare_result":"11111111111111111111","title_slug":"spiral-matrix-ii","has_notes":false,"flag_type":1,"frontend_id":429},{"id":2031396829,"question_id":4,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781328740,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2031396829/","is_pending":"Not Pending","title":"Median of Two Sorted Arrays","memory":"48.9 MB","code":"class Solution {\\n    public double findMedianSortedArrays(int[] array1, int[] array2) {\\n        int n1=array1.length;\\n        int n2=array2.length;\\n        int i=0,j=0,k=0;\\n        int mergedArray[] = new int[n1+n2];\\n        int n3 = n1+n2;\\n        while (i < n1 && j < n2) {\\n            if (array1[i] <= array2[j]) {\\n                mergedArray[k++] = array1[i++];\\n            } else {\\n                mergedArray[k++] = array2[j++];\\n            }\\n        }\\n        while (i < n1) {\\n            mergedArray[k++] = array1[i++];\\n        }\\n        while (j < n2) {\\n            mergedArray[k++] = array2[j++];\\n        }\\n        if(mergedArray.length%2!=0) {\\n            int ind = n3/2;\\n            return (double)mergedArray[ind];\\n        }\\n        else {\\n            int ind2 = n3/2;\\n            int sum = mergedArray[ind2-1]+mergedArray[ind2];\\n            double avg = (double)sum/2;\\n            return avg;\\n        }\\n    }\\n}","compare_result":"","title_slug":"median-of-two-sorted-arrays","has_notes":false,"flag_type":1,"frontend_id":428},{"id":2031382469,"question_id":33,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781327726,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2031382469/","is_pending":"Not Pending","title":"Search in Rotated Sorted Array","memory":"43.7 MB","code":"class Solution {\\n    public int search(int[] nums, int target) {\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]==target) {\\n                return i;\\n            }\\n        }\\n        return -1;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"search-in-rotated-sorted-array","has_notes":false,"flag_type":1,"frontend_id":427},{"id":2031366609,"question_id":4216,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781326565,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2031366609/","is_pending":"Not Pending","title":"Weighted Word Mapping","memory":"46.7 MB","code":"class Solution {\\n    public String mapWordWeights(String[] words, int[] weights) {\\n        StringBuilder sb = new StringBuilder();\\n        for(String str:words) {\\n            int sum=0;\\n            for(int i=0;i<str.length();i++) {\\n                int ind = str.charAt(i)-\'a\';\\n                sum += weights[ind];\\n            }\\n            int rem = sum % 26;\\n            char ch = (char)(122-rem);\\n            sb.append(ch);\\n        }\\n        return new String(sb);\\n    }\\n}","compare_result":"","title_slug":"weighted-word-mapping","has_notes":false,"flag_type":1,"frontend_id":426}],"has_next":true,"last_key":""}'
