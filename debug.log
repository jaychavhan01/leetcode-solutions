notes":false,"flag_type":1,"frontend_id":327},{"id":2005714369,"question_id":1428,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1779036136,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2005714369/","is_pending":"Not Pending","title":"Jump Game III","memory":"52.9 MB","code":"class Solution {\\n    public boolean canReach(int[] arr, int start) {\\n        boolean[] visited = new boolean[arr.length];\\n        return dfs(arr, start, visited);\\n    }\\n\\n    public boolean dfs(int[] arr, int index, boolean[] visited) {\\n\\n        // Out of bounds\\n        if(index < 0 || index >= arr.length) {\\n            return false;\\n        }\\n\\n        // Already visited\\n        if(visited[index]) {\\n            return false;\\n        }\\n\\n        // Found 0\\n        if(arr[index] == 0) {\\n            return true;\\n        }\\n\\n        visited[index] = true;\\n\\n        // Jump forward or backward\\n        return dfs(arr, index + arr[index], visited) ||\\n               dfs(arr, index - arr[index], visited);\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111","title_slug":"jump-game-iii","has_notes":false,"flag_type":1,"frontend_id":326}],"has_next":true,"last_key":""}'
