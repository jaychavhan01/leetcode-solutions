stion_id":242,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776532119,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/1981924961/","is_pending":"Not Pending","title":"Valid Anagram","memory":"46.2 MB","code":"import java.util.Arrays;\\nclass Solution {\\n    public boolean isAnagram(String s, String t) {\\n        char ar1[] = new char[s.length()];\\n        char ar2[] = new char[t.length()];\\n        for(int i=0;i<ar1.length;i++) {\\n            ar1[i] = s.charAt(i);\\n        }\\n        for(int i=0;i<ar2.length;i++) {\\n            ar2[i] = t.charAt(i);\\n        }\\n        Arrays.sort(ar1);\\n        Arrays.sort(ar2);\\n        String s1 = new String(ar1);\\n        String s2 = new String(ar2);\\n        return s1.equals(s2);\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"valid-anagram","has_notes":false,"flag_type":1,"frontend_id":232},{"id":1981011639,"question_id":53,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776437207,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1981011639/","is_pending":"Not Pending","title":"Maximum Subarray","memory":"77.2 MB","code":"class Solution {\\n    public int maxSubArray(int[] nums) {\\n        int max = Integer.MIN_VALUE;\\n        int sum = 0;\\n        for(int i=0;i<nums.length;i++) {\\n            sum += nums[i];\\n            if(sum>max) {\\n                max = sum;\\n            }\\n            if(sum<0) {\\n                sum=0;\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-subarray","has_notes":false,"flag_type":1,"frontend_id":231},{"id":1980993486,"question_id":724,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776435831,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/1980993486/","is_pending":"Not Pending","title":"Find Pivot Index","memory":"47.3 MB","code":"class Solution {\\n    public int pivotIndex(int[] nums) {\\n        int len = nums.length;\\n        int leftsum[] = new int[len];\\n        int rightsum[] = new int[len];\\n        int sum=0;\\n        for(int i=0;i<len;i++) {\\n            leftsum[i]= sum;\\n            sum += nums[i];\\n        }\\n        sum=0;\\n        for(int i=(len-1);i>=0;i--) {\\n            rightsum[i] = sum;\\n            sum += nums[i];\\n        }\\n        for(int i=0;i<len;i++) {\\n            if(leftsum[i]==rightsum[i]) return i;\\n        }\\n        return -1;\\n\\n    }\\n}","compare_result":"","title_slug":"find-pivot-index","has_notes":false,"flag_type":1,"frontend_id":230},{"id":1980977229,"question_id":1603,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776434587,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1980977229/","is_pending":"Not Pending","title":"Running Sum of 1d Array","memory":"44.4 MB","code":"class Solution {\\n    public int[] runningSum(int[] nums) {\\n        int sum=0;\\n        for(int i=0;i<nums.length;i++) {\\n            sum += nums[i];\\n            nums[i] = sum;\\n        }\\n        return nums;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"running-sum-of-1d-array","has_notes":false,"flag_type":1,"frontend_id":229},{"id":1980081262,"question_id":633,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1776346435,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1980081262/","is_pending":"Not Pending","title":"Sum of Square Numbers","memory":"41.9 MB","code"