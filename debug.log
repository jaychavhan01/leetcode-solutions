+ 1 < n && !vis[curr + 1]) {\\n                    vis[curr + 1] = true;\\n                    q.offer(curr + 1);\\n                }\\n\\n                // Left\\n                if (curr - 1 >= 0 && !vis[curr - 1]) {\\n                    vis[curr - 1] = true;\\n                    q.offer(curr - 1);\\n                }\\n\\n                if (map.containsKey(arr[curr])) {\\n                    for (int next : map.get(arr[curr])) {\\n                        if (!vis[next]) {\\n                            vis[next] = true;\\n                            q.offer(next);\\n                        }\\n                    }\\n                    map.remove(arr[curr]);\\n                }\\n            }\\n\\n            steps++;\\n        }\\n\\n        return -1;\\n    }\\n}","compare_result":"111111111111111111111111111111111","title_slug":"jump-game-iv","has_notes":false,"flag_type":1,"frontend_id":485},{"id":2045838042,"question_id":4074,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782394897,"status":10,"status_display":"Accepted","runtime":"49 ms","url":"/submissions/detail/2045838042/","is_pending":"Not Pending","title":"Count Subarrays With Majority Element I","memory":"47.1 MB","code":"class Solution {\\n    public int countMajoritySubarrays(int[] nums, int target) {\\n        int n = nums.length;\\n        int tot = 0;\\n        for(int i=0;i<n;i++) {\\n            int count=0;\\n            for(int j=i;j<n;j++) {\\n                if(nums[j]==target) {\\n                    count++;\\n                }\\n                int len = j-i+1;\\n                if(count>len/2) {\\n                    tot++;\\n                }\\n            }\\n        }\\n        return tot;\\n    }\\n}","compare_result":"","title_slug":"count-subarrays-with-majority-element-i","has_notes":false,"flag_type":1,"frontend_id":484},{"id":2044954728,"question_id":152,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timest