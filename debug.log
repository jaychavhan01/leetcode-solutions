b = new StringBuilder();\\n        String s = word.substring(0,ind+1);\\n        int j=0,k=ind;\\n        char arr[] = s.toCharArray();\\n        while(j<k) {\\n            char c = arr[j];\\n            arr[j] = arr[k];\\n            arr[k] = c;\\n            j++;\\n            k--;\\n        }\\n        sb.append(arr);\\n        sb.append(word.substring(ind+1,word.length()));\\n        return sb.toString();\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"reverse-prefix-of-word","has_notes":false,"flag_type":1,"frontend_id":597},{"id":2097648322,"question_id":2128,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1786087446,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2097648322/","is_pending":"Not Pending","title":"Reverse Prefix of Word","memory":"43 MB","code":"class Solution {\\n    public String reversePrefix(String word, char ch) {\\n        int ind=0;\\n        boolean flag = false;\\n        for(int i=0;i<word.length();i++) {\\n            if(word.charAt(i)==ch) {\\n                ind=i;\\n                flag = true;\\n                break;\\n            }\\n        }\\n        if(!flag) return word;\\n        StringBuilder sb = new StringBuilder();\\n        for(int i=ind;i>=0;i--) {\\n            sb.append(word.charAt(i));\\n        }\\n        sb.append(word.substring(ind+1,word.length()));\\n        return sb.toString();\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"reverse-prefix-of-word","has_notes":false,"flag_type":1,"frontend_id":596},{"id":2096168350,"question_id":3626,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1785993898,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2096