pted","runtime":"1 ms","url":"/submissions/detail/1996759483/","is_pending":"Not Pending","title":"Third Maximum Number","memory":"44.6 MB","code":"class Solution {\\n    public int thirdMax(int[] nums) {\\n        long max = Long.MIN_VALUE;\\n        long max2 = Long.MIN_VALUE;\\n        long max3 = Long.MIN_VALUE;\\n\\n        for(int i=0;i<nums.length;i++) {\\n            long num = nums[i];\\n\\n            // skip duplicates\\n            if(num == max || num == max2 || num == max3) continue;\\n\\n            if(num > max) {\\n                max3 = max2;\\n                max2 = max;\\n                max = num;\\n            }\\n            else if(num > max2) {\\n                max3 = max2;\\n                max2 = num;\\n            }\\n            else if(num > max3) {\\n                max3 = num;\\n            }\\n        }\\n\\n        if(max3 == Long.MIN_VALUE) return (int)max;\\n\\n        return (int)max3;\\n    }\\n}","compare_result":"1111111111111111111111111111111111","title_slug":"third-maximum-number","has_notes":false,"flag_type":1,"frontend_id":257},{"id":1996023338,"question_id":283,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1778001947,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1996023338/","is_pending":"Not Pending","title":"Move Zeroes","memory":"47.7 MB","code":"class Solution {\\n    public void moveZeroes(int[] nums) {\\n        int pos = 0;\\n\\n        for (int i = 0; i < nums.length; i++) {\\n            if (nums[i] != 0) {\\n                int temp = nums[i];\\n                nums[i] = nums[pos];\\n                nums[pos] = temp;\\n                pos++;\\n            }\\n        }\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"move-zeroes","has_notes":false,"flag_type":1,"frontend_id":256},{"id":1994740277,"question_id":560,"lang":"java","lang_name":"Java","time":"5\xc2\