=0;j<nums.length;j++) {\\n                if(nums[j]%divisors[i]==0) {\\n                    count++;\\n                }\\n            }\\n            if(count > max) {\\n                max = count;\\n                min = divisors[i];\\n            } else if (count == max) {\\n                min = Math.min(min, divisors[i]);\\n            }\\n        }\\n        return min;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-the-maximum-divisibility-score","has_notes":false,"flag_type":1,"frontend_id":620},{"id":2115739713,"question_id":3918,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787376987,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2115739713/","is_pending":"Not Pending","title":"Check Divisibility by Digit Sum and Product","memory":"42.2 MB","code":"class Solution {\\n    public boolean checkDivisibility(int n) {\\n        int sum=0;\\n        int mul = 1;\\n        int temp=n;\\n        while(temp>0) {\\n            mul *= temp%10;\\n            sum += temp%10;\\n            temp/=10;\\n        }\\n        return n%(sum+mul)==0;\\n    }\\n}","compare_result":"","title_slug":"check-divisibility-by-digit-sum-and-product","has_notes":false,"flag_type":1,"frontend_id":619},{"id":2115738319,"question_id":3918,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787376901,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2115738319/","is_pending":"Not Pending","title":"Check Divisibility by Digit Sum and Product","memory":"N/A","code":"class Solution {\\n    public boolean checkDivisibility(int n) {\\n        int sum=0;\\n        int mul = 1;\\n        int temp=n;\\n        while(temp>0) {\\n            mul *= temp%10;\\n            sum += temp%10;\\n     