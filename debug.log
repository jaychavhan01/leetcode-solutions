Into Two Arrays I","memory":"46.7 MB","code":"class Solution {\\n    public int[] resultArray(int[] nums) {\\n        if(nums.length<2) return nums;\\n        int len = nums.length;\\n        int ar1[]=new int[len];\\n        int ar2[]=new int[len];\\n        int ind1=0;\\n        int ind2=0;\\n        ar1[0]=nums[0];\\n        ar2[0]=nums[1];\\n        for(int i=2;i<len;i++) {\\n            if(ar1[ind1]>ar2[ind2]) {\\n                ar1[++ind1]=nums[i];\\n            }\\n            else {\\n                ar2[++ind2]=nums[i];\\n            }\\n        }\\n        for(int i=0;i<=ind2;i++) {\\n            ar1[++ind1]=ar2[i];\\n        }\\n        return ar1;\\n    }\\n}","compare_result":"","title_slug":"distribute-elements-into-two-arrays-i","has_notes":false,"flag_type":1,"frontend_id":614},{"id":2113074764,"question_id":125,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1787162239,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2113074764/","is_pending":"Not Pending","title":"Valid Palindrome","memory":"44.4 MB","code":"class Solution {\\n    public boolean isPalindrome(String s) {\\n        int left = 0, right = s.length() - 1;\\n\\n        while (left < right) {\\n\\n            while (left < right && !Character.isLetterOrDigit(s.charAt(left))) {\\n                left++;\\n            }\\n\\n            while (left < right && !Character.isLetterOrDigit(s.charAt(right))) {\\n                right--;\\n            }\\n\\n            if (Character.toLowerCase(s.charAt(left)) != \\n                Character.toLowerCase(s.charAt(right))) {\\n                return false;\\n            }\\n\\n            left++;\\n            right--;\\n        }\\n        return true;\\n    }\\n}","compare_result":"","title_slug":"valid-palindrome","has_notes":false,"flag_type":1,"frontend_id":613},{"id":2111876107,"question_id":3914,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 2\xc2\xa0weeks","