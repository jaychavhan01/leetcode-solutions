 removeElement(int[] nums, int val) {\\n        int count = nums.length;\\n        int ind=0;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]==val) {\\n                count--;\\n            }\\n            else {\\n                nums[ind] = nums[i];\\n                ind++;\\n            }\\n        }\\n        return count;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"remove-element","has_notes":false,"flag_type":1,"frontend_id":387},{"id":2015459387,"question_id":941,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779970040,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2015459387/","is_pending":"Not Pending","title":"Sort Array By Parity","memory":"46.8 MB","code":"class Solution {\\n    public int[] sortArrayByParity(int[] nums) {\\n        int ar[] = new int[nums.length];\\n        if(nums.length==1) return nums;\\n        int eind = 0;\\n        int oind=nums.length-1;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]%2==0) {\\n                ar[eind]=nums[i];\\n                eind++;\\n            }\\n            else {\\n                ar[oind]=nums[i];\\n                oind--;\\n            }\\n        }\\n        return ar;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-array-by-parity","has_notes":false,"flag_type":1,"frontend_id":386}],"has_next":true,"last_key":""}'
