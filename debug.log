.length;\\n        Set<Integer> set = new HashSet<>();\\n        int res[] = new int[2];\\n        int asum = 0;\\n        int esum = ((n*n)*(n*n+1))/2;\\n        for(int i=0;i<n;i++) {\\n            for(int j=0;j<n;j++) {\\n                asum += grid[i][j];\\n                if(set.contains(grid[i][j])) {\\n                    res[0]=grid[i][j];\\n                }\\n                else {\\n                    set.add(grid[i][j]);\\n                }\\n            }\\n        }\\n        res[1] = esum+res[0]-asum;\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-missing-and-repeated-values","has_notes":false,"flag_type":1,"frontend_id":408},{"id":2024262233,"question_id":3227,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780752642,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2024262233/","is_pending":"Not Pending","title":"Find Missing and Repeated Values","memory":"47.4 MB","code":"class Solution {\\n    public int[] findMissingAndRepeatedValues(int[][] grid) {\\n        Set<Integer> set = new HashSet<>();\\n        int res[] = new int[2];\\n        for(int i=0;i<grid.length;i++) {\\n            for(int j=0;j<grid[0].length;j++) {\\n                if(set.contains(grid[i][j])) {\\n                    res[0]=grid[i][j];\\n                }\\n                else {\\n                    set.add(grid[i][j]);\\n                }\\n            }\\n        }\\n        for(int i=1;i<=(grid.length*grid.length);i++) {\\n            if(!set.contains(i)) {\\n                res[1] = i;\\n                break;\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-missing-and-repeated-values","has_notes":false,"flag_type":1,"frontend_id":407},{"id":2024255764,"question_id":3227,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780752134,"status":10,"status_display":"Accepted","runtime":