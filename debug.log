nt romanToInt(String s) {\\n         int tot=0;\\n         int prev = 0;\\n         for(int i=s.length()-1;i>=0;i--) {\\n            int curr = getValue(s.charAt(i));\\n            if(curr<prev)\\n                tot -= curr;\\n            else\\n                tot += curr;\\n            prev = curr;\\n         }\\n         return tot;\\n    }\\n    private int getValue(char c) {\\n        switch(c) {\\n            case \'I\':return 1;\\n            case \'V\':return 5;\\n            case \'X\':return 10;\\n            case \'L\':return 50;\\n            case \'C\':return 100;\\n            case \'D\': return 500;\\n            case \'M\': return 1000;\\n            default : return 0;\\n         }\\n    }\\n}","compare_result":"","title_slug":"roman-to-integer","has_notes":false,"flag_type":1,"frontend_id":524},{"id":2062551592,"question_id":372,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783667025,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2062551592/","is_pending":"Not Pending","title":"Super Pow","memory":"46.3 MB","code":"class Solution {\\n    public int superPow(int a, int[] b) {\\n        int res = 1;\\n        a %= 1337;\\n        for(int i=0;i<b.length;i++) {\\n            res = power(res,10)*power(a,b[i])%1337;\\n        }\\n        return res;\\n    }\\n    int power(int base,int exp) {\\n        int res = 1;\\n        exp %= 1337;\\n        for(int i=1;i<=exp;i++) {\\n            res = (res*base)%1337;\\n        }\\n        return res;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111","title_slug":"super-pow","has_notes":false,"flag_type":1,"frontend_id":523},{"id":2062541310,"question_id":372,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783666444,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2062541310/","is_pending":"Not Pending","title":"Super Po