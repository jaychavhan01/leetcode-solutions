end(count);\\n            }\\n        }\\n        \\n        // Modify the original input array in-place (Required by LeetCode)\\n        char[] temp = sb.toString().toCharArray();\\n        for (int j = 0; j < temp.length; j++) {\\n            chars[j] = temp[j];\\n        }\\n        \\n        return sb.length();\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"string-compression","has_notes":false,"flag_type":1,"frontend_id":341},{"id":2010927232,"question_id":2106,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779551057,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2010927232/","is_pending":"Not Pending","title":"Find Greatest Common Divisor of Array","memory":"45 MB","code":"class Solution {\\n    public int findGCD(int[] nums) {\\n        int max = nums[0];\\n        int min = nums[0];\\n        for(int i=1;i<nums.length;i++) {\\n            if(nums[i]>max) {\\n                max = nums[i];\\n            }\\n            if(nums[i]<min) {\\n                min = nums[i];\\n            }\\n        }\\n        int gcd = 1;\\n        for(int i=2;i<=min;i++) {\\n            if(min%i==0&&max%i==0) {\\n                gcd = i;\\n            }\\n        }\\n        return gcd;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-greatest-common-divisor-of-array","has_notes":false,"flag_type":1,"frontend_id":340},{"id":2010903287,"question_id":1878,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779550043,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2010903287/","is_pending":"Not Pending","title":"Check if Array Is Sorted and Rot