to Hexadecimal","memory":"N/A","code":"class Solution {\\n    public String toHex(int num) {\\n        int temp = num;\\n        StringBuilder sb = new StringBuilder(\\"\\");\\n        while(num>0) {\\n            int rem = num % 16;\\n            if(rem<10) {\\n                char ch1 = (char)(rem + 48);\\n                sb.append(ch1);\\n            }\\n            else {\\n                char ch = (char)(rem + 87);\\n                sb.append(ch);\\n            }\\n            num /= 16;\\n        }\\n        if(num<0)\\n            return \\"ffffffff\\";\\n        else if(temp==0)\\n            return \\"0\\";\\n        else {\\n            return sb.reverse().toString();\\n        }\\n    }\\n}","compare_result":"1111111111111111111111111111111110000011111011011111111111111111111111111111111111111111111111110010","title_slug":"convert-a-number-to-hexadecimal","has_notes":false,"flag_type":1,"frontend_id":452},{"id":2034281347,"question_id":405,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1781546501,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2034281347/","is_pending":"Not Pending","title":"Convert a Number to Hexadecimal","memory":"N/A","code":"class Solution {\\n    public String toHex(int num) {\\n        int temp = num;\\n        StringBuilder sb = new StringBuilder(\\"\\");\\n        while(num>0) {\\n            int rem = num % 16;\\n            if(rem<10) {\\n                char ch1 = (char)(rem + 48);\\n                sb.append(ch1);\\n            }\\n            else {\\n                char ch = (char)(rem + 87);\\n                sb.append(ch);\\n            }\\n            num /= 16;\\n        }\\n        if(num<0)\\n            return \\"ffffffff\\";\\n        else {\\n            return sb.reverse().toString();\\n        }\\n    }\\n}","compare_result":"1101111111111111111111111111111110000011111011011111111111111111111111111111111111111111111111110010","title_s