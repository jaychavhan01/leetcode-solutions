            end--;\\n            }\\n        }\\n\\n    }\\n}","compare_result":"111111111111111111111","title_slug":"rotate-image","has_notes":false,"flag_type":1,"frontend_id":359},{"id":2011624400,"question_id":728,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779617886,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2011624400/","is_pending":"Not Pending","title":"Self Dividing Numbers","memory":"42.4 MB","code":"class Solution {\\n    public List<Integer> selfDividingNumbers(int left, int right) {\\n        List<Integer> res = new ArrayList<>();\\n        for(int i=left;i<=right;i++) {\\n            int temp = i;\\n            boolean flag = true;\\n            while(temp>0) {\\n                int ld = temp % 10;\\n                if(ld==0|| i % ld != 0) {\\n                    flag = false;\\n                    break;\\n                }\\n                temp /= 10;\\n            }\\n            if(flag) res.add(i);\\n        }\\n        return res;\\n    }\\n}","compare_result":"1111111111111111111111111111111","title_slug":"self-dividing-numbers","has_notes":false,"flag_type":1,"frontend_id":358},{"id":2011617322,"question_id":1064,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779617240,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2011617322/","is_pending":"Not Pending","title":"Smallest Integer Divisible by K","memory":"42.2 MB","code":"class Solution {\\n    public int smallestRepunitDivByK(int k) {\\n\\n        if(k % 2 == 0 || k % 5 == 0) {\\n            return -1;\\n        }\\n\\n        int rem = 0;\\n\\n        for(int len = 1; len <= k; len++) {\\n            rem = (rem * 10 + 1) % k;\\n\\n            if(rem == 0) {\\n                return len;\\n            }\\n        }\\n\\n        return -1;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111