  char[] ele = strs[i].toCharArray();\\n\\n            Arrays.sort(ele);\\n\\n            String key = new String(ele);\\n\\n            // if key not present create new list\\n            if(!map.containsKey(key)) {\\n                map.put(key, new ArrayList<>());\\n            }\\n\\n            // add original string\\n            map.get(key).add(strs[i]);\\n        }\\n\\n        return new ArrayList<>(map.values());\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"group-anagrams","has_notes":false,"flag_type":1,"frontend_id":312},{"id":2002923746,"question_id":2892,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778757965,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2002923746/","is_pending":"Not Pending","title":"Check if Array is Good","memory":"45.1 MB","code":"class Solution {\\n    public boolean isGood(int[] nums) {\\n        Arrays.sort(nums);\\n        int max = nums[nums.length-1];\\n\\n        if(nums.length!=max+1) return false;\\n        for(int i=0;i<max;i++) {\\n            if(i+1!=nums[i]) return false;\\n        }\\n        return true;\\n    }\\n}","compare_result":"","title_slug":"check-if-array-is-good","has_notes":false,"flag_type":1,"frontend_id":311},{"id":2002911228,"question_id":290,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778756810,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2002911228/","is_pending":"Not Pending","title":"Word Pattern","memory":"43 MB","code":"class Solution {\\n    public boolean wordPattern(String pattern, String s) {\\n\\n        String[] st = s.split(\\" \\");\\n\\n        if(pattern.length() != st.length)\\n            return false;\\n\\n        HashMap<Character, String> map1 = new HashMap<>();\\n        HashMap<String, Character> map2 = new HashMap<>();\\n\\n        for(int i = 0; i < st.length; i++) {\\n\\n            char ch = pattern.charAt(i);\\n            String word = st[i];\\n\\n            if(map1.containsKey(ch)) {\\n                if(!map1.get(ch).equals(word))\\n                    return false;\\n            }\\n            else {\\n                map1.put(ch, word);\\n            }\\n\\n            if(map2.containsKey(word)) {\\n                if(map2.get(word) != ch)\\n                    return false;\\n            }\\n            else {\\n                map2.put(word, ch);\\n            }\\n        }\\n\\n        return true;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111","title_slug":"word-pattern","has_notes":false,"flag_type":1,"frontend_id":310},{"id":2002911131,"question_id":290,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778756800,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2002911131/","is_pending":"Not Pending","title":"Word Pattern","memory":"42.5 MB","code":"class Solution {\\n    public boolean wordPattern(String pattern, String s) {\\n\\n        String[] st = s.split(\\" \\");\\n\\n        if(pattern.length() != st.length)\\n            return false;\\n\\n        HashMap<Character, String> map1 = new HashMap<>();\\n        HashMap<String, Character> map2 = new HashMap<>();\\n\\n        for(int i = 0; i < st.length; i++) {\\n\\n            char ch = pattern.charAt(i);\\n            String word = st[i];\\n\\n            if(map1.containsKey(ch)) {\\n                if(!map1.get(ch).equals(word))\\n                    return false;\\n            }\\n            else {\\n                map1.put(ch, word);\\n            }\\n\\n            if(map2.containsKey(word)) {\\n                if(map2.get(word) != ch)\\n                    return false;\\n            }\\n            else {\\n                map2.put(word, ch);\\n            }\\n        }\\