sions/detail/2001297893/","is_pending":"Not Pending","title":"Intersection of Two Arrays II","memory":"44.6 MB","code":"class Solution {\\n    public int[] intersect(int[] nums1, int[] nums2) {\\n\\n        ArrayList<Integer> ar = new ArrayList<>();\\n        boolean used[] = new boolean[nums2.length];\\n\\n        for(int i = 0; i < nums1.length; i++) {\\n\\n            for(int j = 0; j < nums2.length; j++) {\\n\\n                if(nums1[i] == nums2[j] && !used[j]) {\\n                    ar.add(nums1[i]);\\n                    used[j] = true;\\n                    break;\\n                }\\n            }\\n        }\\n\\n        int res[] = new int[ar.size()];\\n\\n        for(int i = 0; i < ar.size(); i++) {\\n            res[i] = ar.get(i);\\n        }\\n\\n        return res;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111","title_slug":"intersection-of-two-arrays-ii","has_notes":false,"flag_type":1,"frontend_id":291},{"id":2001266802,"question_id":459,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778583026,"status":10,"status_display":"Accepted","runtime":"76 ms","url":"/submissions/detail/2001266802/","is_pending":"Not Pending","title":"Repeated Substring Pattern","memory":"47.1 MB","code":"class Solution {\\n    public boolean repeatedSubstringPattern(String s) {\\n        String doubled = s + s;\\n        return doubled.substring(1, doubled.length() - 1).contains(s);\\n    }\\n}\\n","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"repeated-substring-pattern","has_notes":false,"flag_type":1,"frontend_id":290},{"id":2001263763,"question_id":459,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778582747,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2001263763/","is_pending":"Not Pending","title":"Repeated Substring Pattern","memory":"N/A","code":"class Solution {\\n    public boolean repeatedSubstringPattern(String s) {\\n       int st = 0;\\n        int ind = -1;\\n        for(int i=1;i<s.length()-1;i++) {\\n            if(s.charAt(i)==s.charAt(st)) {\\n                ind = i;\\n                break;\\n            }\\n        }\\n        if(ind==-1) return false;\\n        else {\\n            String sub = s.substring(0,ind);\\n            int temp = 0;\\n            while(ind<s.length()) {\\n                if(!(s.substring(temp,ind).equals(sub))) {\\n                    return false;\\n                }\\n                temp += sub.length();\\n                ind += sub.length();\\n            }\\n            \\n        }\\n        return true;\\n    }\\n}","compare_result":"1110110011110100011111111101110111111100101000011100111110000000000000000111111111111111111111111110000000000000000000001011001111","title_slug":"repeated-substring-pattern","has_notes":false,"flag_type":1,"frontend_id":289},{"id":2001251161,"question_id":387,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1778581588,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2001251161/","is_pending":"Not Pending","title":"First Unique Character in a String","memory":"47.2 MB","code":"class Solution {\\n    public int firstUniqChar(String s) {\\n        int ar[] = new int[26];\\n        \\n        // 1. Count frequencies\\n        for(int i = 0; i < s.length(); i++) {\\n            int ind = s.charAt(i) - \'a\';\\n            ar[ind]++;\\n        }\\n        for(int i = 0; i < s.length(); i++) {\\n            int ind = s.charAt(i) - \'a\';\\n            if(ar[ind] == 1) {\\n                return i; \\n            }\\n        }\\n        \\n        return -1;\\n    }\\n}\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","titl