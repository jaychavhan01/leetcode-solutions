ses String Path","memory":"75.1 MB","code":"class Solution {\\n    private Boolean[][][] memo;\\n    private int m, n;\\n    public boolean hasValidPath(char[][] grid) {\\n        m = grid.length;\\n        n = grid[0].length;\\n        if ((m + n - 1) % 2 != 0) {\\n            return false;\\n        }\\n        if (grid[0][0] == \')\' || grid[m - 1][n - 1] == \'(\') {\\n            return false;\\n        }\\n        int maxOpen = (m + n) / 2;\\n        memo = new Boolean[m][n][maxOpen + 1];\\n        return dfs(grid, 0, 0, 0);\\n    }\\n\\n    private boolean dfs(char[][] grid, int r, int c, int open) {\\n        if (grid[r][c] == \'(\') {\\n            open++;\\n        } else {\\n            open--;\\n        }\\n        if (open < 0 || open > (m + n) / 2) {\\n            return false;\\n        }\\n        if (r == m - 1 && c == n - 1) {\\n            return open == 0;\\n        }\\n        if (memo[r][c][open] != null) {\\n            return memo[r][c][open];\\n        }\\n        boolean foundPath = false;\\n        if (r + 1 < m) {\\n            foundPath = dfs(grid, r + 1, c, open);\\n        }\\n        if (!foundPath && c + 1 < n) {\\n            foundPath = dfs(grid, r, c + 1, open);\\n        }\\n        return memo[r][c][open] = foundPath;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"check-if-there-is-a-valid-parentheses-string-path","has_notes":false,"flag_type":1,"frontend_id":641},{"id":2155679499,"question_id":1737,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week","timestamp":1790578295,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2155679499/","is_pending":"Not Pending","title":"Maximum Nesting Depth of the Parentheses","memory":"42.6 MB","code":"class Solution {\\n    public int maxDepth(String s) {\\n        int max = 0;\\n        int count=0;\\n        for(int i=0;i<s.length();i++) {\\n            if(s.charAt(i)==\'(\') count++;\\n            else if(s.charAt(i)==\')\') count--;\\n            max = Math.max(count,max);\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-nesting-depth-of-the-parentheses","has_notes":false,"flag_type":1,"frontend_id":640},{"id":2134972418,"question_id":182,"lang":"mysql","lang_name":"MySQL","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1788862649,"status":10,"status_display":"Accepted","runtime":"374 ms","url":"/submissions/detail/2134972418/","is_pending":"Not Pending","title":"Duplicate Emails","memory":"0.0B","code":"# Write your MySQL query statement below\\nselect email as Email from Person group by email having count(email)>1;","compare_result":"111111111111111","title_slug":"duplicate-emails","has_notes":false,"flag_type":1,"frontend_id":639},{"id":2134960848,"question_id":176,"lang":"mysql","lang_name":"MySQL","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1788861976,"status":10,"status_display":"Accepted","runtime":"347 ms","url":"/submissions/detail/2134960848/","is_pending":"Not Pending","title":"Second Highest Salary","memory":"0.0B","code":"# Write your MySQL query statement below\\nselect max(salary) as SecondHighestSalary  \\nfrom employee \\nwhere  salary < (select max(salary)\\nfrom employee ); \\n\\n\\n-- select salary as SecondHighestSalary  \\n-- from Employee\\n-- order by salary desc\\n-- limit one;","compare_result":"1111111111","title_slug":"second-highest-salary","has_notes":false,"flag_type":1,"frontend_id":638},{"id":2134917003,"question_id":4245,"lang":"java","lang_name":"Java","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1788859403,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2134917003/","is_pending":"Not Pending","title":"Count Commas in Range","memory":"42.5 MB",