     int[] ar = {1000,900,500,400,100,90,50,40,10,9,5,4,1};\\n        String[] sym = {\\"M\\",\\"CM\\",\\"D\\",\\"CD\\",\\"C\\",\\"XC\\",\\"L\\",\\"XL\\",\\"X\\",\\"IX\\",\\"V\\",\\"IV\\",\\"I\\"};\\n        StringBuilder sb = new StringBuilder();\\n        for(int i=0;i<ar.length;i++) {\\n            while(num>=ar[i]) {\\n                sb.append(sym[i]);\\n                num -= ar[i];\\n            }\\n            if(num==0) {\\n                break;\\n            }\\n        }\\n        return sb.toString();\\n    }\\n}","compare_result":"","title_slug":"integer-to-roman","has_notes":false,"flag_type":1,"frontend_id":448},{"id":2034213845,"question_id":13,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1781543153,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2034213845/","is_pending":"Not Pending","title":"Roman to Integer","memory":"45.4 MB","code":"class Solution {\\n    public int romanToInt(String s) {\\n         int tot=0;\\n         int prev = 0;\\n         for(int i=s.length()-1;i>=0;i--) {\\n            int curr = getValue(s.charAt(i));\\n            if(curr<prev)\\n                tot -= curr;\\n            else\\n                tot += curr;\\n            prev = curr;\\n         }\\n         return tot;\\n    }\\n    private int getValue(char c) {\\n        switch(c) {\\n            case \'I\':return 1;\\n            case \'V\':return 5;\\n            case \'X\':return 10;\\n            case \'L\':return 50;\\n            case \'C\':return 100;\\n            case \'D\': return 500;\\n            case \'M\': return 1000;\\n            default : return 0;\\n         }\\n    }\\n}","compare_result":"","title_slug":"roman-to-integer","has_notes":false,"flag_type":1,"frontend_id":447},{"id":2034202366,"question_id":13,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1781542594,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2034202366/","is_pending":"Not Pending","title":"Roman to Integer","memory":"46.4 MB","code":"class Solution {\\n    public int romanToInt(String s) {\\n         Map<Character, Integer> dictionary = Map.of(\\n            \'I\',1,\'V\', 5,\'X\',10,\'L\',50,\'C\',100,\'D\',500,\'M\',1000\\n        );\\n        int total = 0;\\n        for(int i=0;i<s.length();i++) {\\n           if ((i + 1) < s.length() && dictionary.get(s.charAt(i)) < dictionary.get(s.charAt(i + 1)))\\n                total -= dictionary.get(s.charAt(i));\\n            else\\n                total += dictionary.get(s.charAt(i));\\n        }\\n        return total;\\n    }\\n}","compare_result":"","title_slug":"roman-to-integer","has_notes":false,"flag_type":1,"frontend_id":446}],"has_next":true,"last_key":""}'
