        }\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111","title_slug":"maximum-xor-of-two-numbers-in-an-array","has_notes":false,"flag_type":1,"frontend_id":511},{"id":2052740918,"question_id":421,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782931541,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2052740918/","is_pending":"Not Pending","title":"Maximum XOR of Two Numbers in an Array","memory":"N/A","code":"class Solution {\\n    public int findMaximumXOR(int[] nums) {\\n        int max=0;\\n        for(int i=0;i<nums.length;i++) {\\n            for(int j=i+1;j<nums.length;j++) {\\n                max = Math.max(max,nums[i]^nums[j]);\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111110000","title_slug":"maximum-xor-of-two-numbers-in-an-array","has_notes":false,"flag_type":1,"frontend_id":510},{"id":2052738617,"question_id":421,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782931391,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2052738617/","is_pending":"Not Pending","title":"Maximum XOR of Two Numbers in an Array","memory":"N/A","code":"class Solution {\\n    public int findMaximumXOR(int[] nums) {\\n        int max=0;\\n        for(int i=0;i<nums.length-1;i++) {\\n            if((nums[i]^nums[i+1])>max) {\\n                max = nums[i]^nums[i+1];\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"1111011100011101110111000000000000010110101010","title_slug":"maximum-xor-of-two-numbers-in-an-array","has_notes":false,"flag_type":1,"frontend_id":509},{"id":2052033280,"question_id":415,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782890092,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2052033280/","is_pending":"Not Pending","title":"Add Strings","memory":"43.8 MB","code":"class Solution {\\n    public String addStrings(String num1, String num2) {\\n        StringBuilder sb = new StringBuilder();\\n        int i=num1.length()-1;\\n        int j=num2.length()-1;\\n        int carry=0;\\n\\n        while(i>=0||j>=0||carry>0) {\\n\\n            int sum = carry;\\n            if(i>=0) {\\n                sum += num1.charAt(i)-\'0\';\\n                i--;\\n            }\\n\\n            if(j>=0) {\\n                sum += num2.charAt(j)-\'0\';\\n                j--;\\n            }\\n\\n            carry=sum/10;\\n\\n            sb.append(sum%10);\\n        }\\n        return sb.reverse().toString();\\n    }\\n}","compare_result":"","title_slug":"add-strings","has_notes":false,"flag_type":1,"frontend_id":508},{"id":2052024545,"question_id":415,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782889582,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2052024545/","is_pending":"Not Pending","title":"Add Strings","memory":"N/A","code":"class Solution {\\n    public String addStrings(String num1, String num2) {\\n        long a = Long.parseLong(num1);\\n        long b = Long.parseLong(num2);\\n        return String.valueOf(a+b);\\n    }\\n}","compare_result":"","title_slug":"add-strings","has_notes":false,"flag_type":1,"frontend_id":507},{"id":2052023210,"question_id":415,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782889508,"status":15,"status_display":"Runtime Error","runtime":"N/A","url":"/submissions/detail/2052023210/","is_pending":"Not Pending","title":"Add Strings","memory":"N/A","code":"class Solution {\\n    public String addStrings(String num1, String num2) {\\n        int a = Integer.parseInt(num1);\\n        int b = Integer.parseInt(num2);\\n        return String.valueOf(a+b);\\n    }\\n}","compare_result":"","title_slug":"add-strings","has_notes":false,"flag_t