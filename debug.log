s(String word) {\\n\\n        int[] lowerLast = new int[26];\\n        int[] upperFirst = new int[26];\\n\\n        Arrays.fill(lowerLast, -1);\\n        Arrays.fill(upperFirst, -1);\\n\\n        for (int i = 0; i < word.length(); i++) {\\n            char ch = word.charAt(i);\\n\\n            if (Character.isLowerCase(ch)) {\\n                lowerLast[ch - \'a\'] = i;\\n            } else {\\n                if (upperFirst[ch - \'A\'] == -1) {\\n                    upperFirst[ch - \'A\'] = i;\\n                }\\n            }\\n        }\\n\\n        int count = 0;\\n\\n        for (int i = 0; i < 26; i++) {\\n            if (lowerLast[i] != -1 &&\\n                upperFirst[i] != -1 &&\\n                lowerLast[i] < upperFirst[i]) {\\n\\n                count++;\\n            }\\n        }\\n\\n        return count;\\n    }\\n}","compare_result":"","title_slug":"count-the-number-of-special-characters-ii","has_notes":false,"flag_type":1,"frontend_id":368},{"id":2013478368,"question_id":139,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779788955,"status":10,"status_display":"Accepted","runtime":"8 ms","url":"/submissions/detail/2013478368/","is_pending":"Not Pending","title":"Word Break","memory":"46.5 MB","code":"class Solution {\\n    public boolean wordBreak(String s, List<String> wordDict) {\\n        \\n        HashSet<String> set = new HashSet<>(wordDict);\\n        \\n        boolean[] dp = new boolean[s.length() + 1];\\n        \\n        dp[0] = true;\\n        \\n        for(int i = 1; i <= s.length(); i++) {\\n            \\n            for(int j = 0; j < i; j++) {\\n                \\n                if(dp[j] && set.contains(s.substring(j, i))) {\\n                    dp[i] = true;\\n                    break;\\n                }\\n            }\\n        }\\n        \\n        return dp[s.length()];\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111","title_slug":"word-break","has_notes":false,"flag_type":1,"frontend_id":367},{"id":2013353320,"question_id":3408,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779779714,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2013353320/","is_pending":"Not Pending","title":"Count the Number of Special Characters I","memory":"43.9 MB","code":"class Solution {\\n    public int numberOfSpecialChars(String word) {\\n        int count = 0;\\n        HashSet<Character> set = new HashSet<>();\\n        for(int i=0;i<word.length();i++) {\\n            set.add(word.charAt(i));\\n        }\\n        for(int i=97;i<=122;i++) {\\n            int j = i-32;\\n            if(set.contains((char)i)&&set.contains((char)j)) {\\n                count++;\\n            }\\n        }\\n        return count;\\n    }\\n}","compare_result":"","title_slug":"count-the-number-of-special-characters-i","has_notes":false,"flag_type":1,"frontend_id":366}],"has_next":true,"last_key":""}'
