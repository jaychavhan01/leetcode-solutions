istNode(int val, ListNode next) { this.val = val; this.next = next; }\\n * }\\n */\\nclass Solution {\\n    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {\\n        ListNode dummy = new ListNode(0);\\n        ListNode curr = dummy;\\n\\n        int carry = 0;\\n\\n        while (l1 != null || l2 != null || carry != 0) {\\n\\n            int sum = carry;\\n\\n            if (l1 != null) {\\n                sum += l1.val;\\n                l1 = l1.next;\\n            }\\n\\n            if (l2 != null) {\\n                sum += l2.val;\\n                l2 = l2.next;\\n            }\\n\\n            carry = sum / 10;\\n\\n            curr.next = new ListNode(sum % 10);\\n            curr = curr.next;\\n        }\\n\\n        return dummy.next;\\n    }\\n}","compare_result":"","title_slug":"add-two-numbers","has_notes":false,"flag_type":1,"frontend_id":593},{"id":2094324781,"question_id":4107,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months","timestamp":1785862492,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2094324781/","is_pending":"Not Pending","title":"Find Missing Elements","memory":"46.8 MB","code":"class Solution {\\n    public List<Integer> findMissingElements(int[] nums) {\\n        List<Integer> res = new ArrayList<>();\\n        int max=nums[0];\\n        int min=nums[0];\\n        for(int num:nums) {\\n            if(num>max) max=num;\\n            if(num<min) min=num;\\n        }\\n        Set<Integer> ele = new HashSet<>();\\n        for(int num:nums) {\\n            ele.add(num);\\n        }\\n        for(int i=min+1;i<max;i++) {\\n            if(!ele.contains(i)) res.add(i);\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-missing-elements","has_notes":false,"flag_type":1,"frontend_id":592},{"id":2094314836,"question_id":4107,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months","timestamp":1785862134,"status":11,"status_display":"Wrong Answer","runtime":"