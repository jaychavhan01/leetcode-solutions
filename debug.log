de":"class Solution {\\n\\n    public int lengthOfLongestSubstring(String s) {\\n\\n        HashSet<Character> set = new HashSet<>();\\n\\n        int left = 0;\\n        int max = 0;\\n\\n        for(int right = 0; right < s.length(); right++) {\\n\\n            while(set.contains(s.charAt(right))) {\\n\\n                set.remove(s.charAt(left));\\n\\n                left++;\\n            }\\n\\n            set.add(s.charAt(right));\\n\\n            max = Math.max(max, right - left + 1);\\n        }\\n\\n        return max;\\n    }\\n}","compare_result":"","title_slug":"longest-substring-without-repeating-characters","has_notes":false,"flag_type":1,"frontend_id":317},{"id":2003735884,"question_id":451,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1778842988,"status":10,"status_display":"Accepted","runtime":"13 ms","url":"/submissions/detail/2003735884/","is_pending":"Not Pending","title":"Sort Characters By Frequency","memory":"46.7 MB","code":"class Solution {\\n    public String frequencySort(String s) {\\n        int freq[] = new int[123];\\n        int max=0;\\n        for(int i=0;i<s.length();i++) {\\n            int ind = s.charAt(i);\\n            freq[ind]++;\\n            max = Math.max(max,freq[ind]);\\n        }\\n        StringBuilder sb = new StringBuilder(\\"\\");\\n        while(max>0) {\\n            for(int i=48;i<freq.length;i++) {\\n                if(freq[i]==max) {\\n                    char ch = (char)i;\\n                    for(int j = 0; j < max; j++) {\\n                        sb.append(ch);\\n                    }\\n                    freq[i]=0;\\n                }\\n            }\\n            max--;\\n        }\\n        return sb.toString();\\n\\n    }\\n}","compare_result":"111111111111111111111111111111111","title_slug":"sort-characters-by-frequency","has_notes":false,"flag_type":1,"frontend_id":316},{"id":2003730443,"question_id":459,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months