n            }\\n        }\\n\\n        for(int i=1;i<=m;i++) {\\n            for(int j=1;j<=n;j++) {\\n                char sc = s.charAt(i-1);\\n                char pc = p.charAt(j-1);\\n\\n                if(pc==\'.\'||pc==sc) {\\n                    dp[i][j] = dp[i-1][j-1];\\n                }\\n                else if (pc==\'*\'){\\n                    char prev = p.charAt(j-2);\\n                    boolean match0 = dp[i][j-2];\\n                    boolean match1OrMore = (prev == \'.\'||prev ==sc) && dp[i-1][j];\\n\\n                    dp[i][j] = match0 || match1OrMore;\\n                }\\n            }\\n        }\\n        return dp[m][n];\\n    }\\n}","compare_result":"","title_slug":"regular-expression-matching","has_notes":false,"flag_type":1,"frontend_id":634},{"id":2129181245,"question_id":10,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month","timestamp":1788411135,"status":15,"status_display":"Runtime Error","runtime":"N/A","url":"/submissions/detail/2129181245/","is_pending":"Not Pending","title":"Regular Expression Matching","memory":"N/A","code":"class Solution {\\n    public boolean isMatch(String s, String p) {\\n        int m = s.length();\\n        int n = p.length();\\n\\n        boolean dp[][] = new boolean[m+1][n+1];\\n        dp[0][0]=true;\\n\\n        for(int j=2;j<=n;j++) {\\n            if(p.charAt(j-1)==\'*\') {\\n                dp[0][j] = dp[0][j-2];\\n            }\\n        }\\n\\n        for(int i=1;i<=m;i++) {\\n            for(int j=1;j<=n;j++) {\\n                char sc = s.charAt(i-1);\\n                char pc = s.charAt(j-1);\\n\\n                if(pc==\'.\'||pc==sc) {\\n                    dp[i][j] = dp[i-1][j-1];\\n                }\\n                else if (pc==\'*\'){\\n                    char prev = p.charAt(j-2);\\n                    boolean match0 = dp[i][j-2];\\n                    boolean match1OrMore = (prev == \'.\'||prev ==sc) && dp[i-1][j];\\n\\n                    dp[i][j] = match0 || match1OrMore;\\n                }\\n            }\\n        }\\n        return dp[m][n];\\n    }\\n}","compare_result":"","title_slug":"regular-expression-matching","has_notes":false,"flag_type":1,"frontend_id":633},{"id":2127227250,"question_id":898,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month","timestamp":1788267714,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2127227250/","is_pending":"Not Pending","title":"Transpose Matrix","memory":"46.6 MB","code":"class Solution {\\n    public int[][] transpose(int[][] matrix) {\\n        int r = matrix.length;\\n        int c = matrix[0].length;\\n        int res[][] = new int[c][r];\\n\\n        for(int i=0;i<c;i++) {\\n            for(int j=0;j<r;j++) {\\n                res[i][j] = matrix[j][i];\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"111111111111111111111111111111111111","title_slug":"transpose-matrix","has_notes":false,"flag_type":1,"frontend_id":632},{"id":2124959205,"question_id":2212,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month","timestamp":1788088805,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2124959205/","is_pending":"Not Pending","title":"Removing Minimum and Maximum From Array","memory":"86.6 MB","code":"class Solution {\\n    public int minimumDeletions(int[] nums) {\\n        int n=nums.length;\\n        if(n<=2) return n;\\n        int min=0;\\n        int max=0;\\n        for(int i=1;i<n;i++) {\\n            if(nums[i]<nums[min])\\n                min=i;\\n            if(nums[i]>nums[max])\\n                max=i;\\n        }\\n        int left = Math.min(min,max);\\n        int right = Math.max(min,max);\\n\\n        int front = right+1;\\n        int back = n-left;\\n        int frbc = (left+1)+(n-right);\\n\\n        return Math.min(front,Math.min(back,frbc));\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111","title_slug":"removing-minimum-and-maximum-from-array","has_notes":false,"flag_type":1,"frontend_id":631},{"id":2123893819,"question_id":189,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month","timestamp":1788012237,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2123893819/","is_pending":"Not Pending","title":"Rotate Array","memory":"268.5 MB","code":"class Solution {\\n    public void rotate(int[] nums, int k) {\\n        int n = nums.length;   \\n        k = k % n;\\n        reverse(nums, 0, n - 1);  \\n        reverse(nums, 0, k - 1);\\n        reverse(nums, k, n - 1);\\n    }\\n    \\n    private void reverse(int[] nums, int left, int right) {\\n        while (left < right) {\\n            int temp = nums[left];\\n            nums[left] = nums[right];\\n            nums[right] = temp;\\n            left++;\\n            right--;\\n        }\\n    }\\n}","compare_result":"","title_slug":"rotate-array","has_notes":false,"flag_type":1,"frontend_id":630},{"id":2122904407,"question_id":3988,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month","timestamp":1787923411,"status":10,"status_display":"Accepted","runtime":"128 ms","url":"/submissions/detail/2122904407/","is_pending":"Not Pending","title":"Valid K-Unique Subarrays I","memory":"232.3 MB","code":"class Solution {\\n    int uniqueCount = 0;\\n    int oddCount = 0;\\n    int[] freq = new int[100005];\\n\\n    private void add(int val) {\\n        if (freq[val] == 0) {\\n            uniqueCount++;\\n        }\\n        \\n        if (freq[val] % 2 == 0) {\\n            oddCount++;\\n        } else {\\n            oddCount--;\\n        }\\n        freq[val]++;\\n    }\\n\\n    private void remove(int val) {\\n        if (freq[val] % 2 == 0) {\\n            oddCount++;\\n        } else {\\n            oddCount--;\\n        }\\n        freq[val]--;\\n        \\n        if (freq[val] == 0) {\\n            uniqueCount--;\\n        }\\n    }\\n\\n    public boolean[] validSubarrays(int[] nums, int k, int[][] queries) {\\n        int q = queries.length;\\n        int n = nums.length;\\n\\n        int[][] Q = new int[q][3];\\n        for (int i = 0; i < q; i++) {\\n            Q[i][0] = queries[i][0];\\n            Q[i][1] = queries[i][1];\\n            Q[i][2] = i;\\n        }\\n\\n        int blockSize = (int) Math.max(1, Math.sqrt(n));\\n        Arrays.sort(Q, (a, b) -> {\\n            int blockA = a[0] / blockSize;\\n            int blockB = b[0] / blockSize;\\n            if (blockA != blockB) {\\n                return Integer.compare(blockA, blockB);\\n            }\\n\\n            return (blockA % 2 == 1) ? Integer.compare(b[1], a[1]) : Integer.compare(a[1], b[1]);\\n        });\\n\\n        boolean[] ans = new boolean[q];\\n        int currL = 0, currR = -1;\\n        \\n        for (int i = 0; i < q; i++) {\\n            int L = Q[i][0];\\n            int R = Q[i][1];\\n            int id = Q[i][2];\\n\\n            while (currL > L) {\\n                currL--;\\n                add(nums[currL]);\\n            }\\n            while (currR < R) {\\n                currR++;\\n                add(nums[currR]);\\n            }\\n            while (currL < L) {\\n                remove(nums[currL]);\\n                currL++;\\n            }\\n            while (currR > R) {\\n                remove(nums[currR]);\\n                currR--;\\n            }\\n\\n            ans[id] = (uniqueCount == k) && (oddCount == 0);\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"valid-k-unique-subarrays-i","has_notes":false,"flag_type":1,"frontend_id":629},{"id":2122901891,"question_id":3988,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787923228,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2122901891/","is_pending":"Not Pending","title":"Valid K-Unique Subarrays I","memory":"N/A","code":"class Solution {\\n    public boolean[] validSubarrays(int[] nums, int k, int[][] queries) {\\n        int len = queries.length;\\n        boolean res[] = new boolean[len];\\n        for(int i=0;i<queries.length;i++) {\\n            int st = queries[i][0];\\n            int end = queries[i][1];\\n            HashMap<Integer,Integer> map = new HashMap<>();\\n\\n            while(st<=end) {\\n                map.put(nums[st],map.getOrDefault(nums[st],0)+1);\\n                st++;\\n            }\\n            boolean flag = true;\\n            int count=0;\\n            for(Map.Entry<Integer,Integer> m:map.entrySet()) {\\n                if(m.getValue()%2!=0) {\\n                    flag = false;\\n                }\\n                count++;\\n            }\\n            if(flag && count==k) res[i]=true;\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"valid-k-unique-subarrays-i","has_notes":false,"flag_type":1,"frontend_id":628},{"id":2122292539,"question_id":1,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787857375,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2122292539/","is_pending":"Not Pending","title":"Two Sum","memory":"47.4 MB","code":"import java.util.HashMap;\\n\\nclass Solution {\\n    public int[] twoSum(int[] nums, int target) {\\n        HashMap<Integer, Integer> map = new HashMap<>();\\n        \\n        for (int i = 0; i < nums.length; i++) {\\n            int complement = target - nums[i];\\n            \\n            if (map.containsKey(complement)) {\\n                return new int[] { map.get(complement), i };\\n            }\\n            \\n            map.put(nums[i], i);\\n        }\\n        \\n        return new int[] {};\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"two-sum","has_notes":false,"flag_type":1,"frontend_id":627},{"id":2120385590,"question_id":3150,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787721166,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2120385590/","is_pending":"Not Pending","title":"Shortest and Lexicographically Smallest Beautiful String","memory":"44.4 MB","code":"class Solution {\\n    public String shortestBeautifulSubstring(String s, int k) {\\n        int left =0;\\n        int count = 0;\\n        String res = \\"\\";\\n\\n        for(int right=0;right<s.length();right++) {\\n            if(s.charAt(right)==\'1\') {\\n                count++;\\n            }\\n            while(left<=right && (count>k || s.charAt(left)==\'0\')) {\\n                if(s.charAt(left)==\'1\') {\\n                    count--;\\n                }\\n                left++;\\n            }\\n\\n            if(count==k) {\\n                String current = s.substring(left,right+1);\\n                if(res.isEmpty()||current.length()<res.length()||\\n                (current.length()==res.length()&& current.compareTo(res) <0))\\n                res=current;\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"shortest-and-lexicographically-smallest-beautiful-string","has_notes":false,"flag_type":1,"frontend_id":626}],"has_next":true,"last_key":""}'
