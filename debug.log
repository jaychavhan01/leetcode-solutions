ight]\\n                    ));\\n\\n                    while(left < right &&\\n                          nums[left] == nums[left + 1])\\n                        left++;\\n\\n                    while(left < right &&\\n                          nums[right] == nums[right - 1])\\n                        right--;\\n\\n                    left++;\\n                    right--;\\n                }\\n                else if(sum < 0) {\\n                    left++;\\n                }\\n                else {\\n                    right--;\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":425},{"id":2030047550,"question_id":15,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781200258,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2030047550/","is_pending":"Not Pending","title":"3Sum","memory":"N/A","code":"class Solution {\\n    public List<List<Integer>> threeSum(int[] nums) {\\n\\n    Set<List<Integer>> uniqueTriplets = new HashSet<>();\\n\\n    int n = nums.length;\\n\\n    for (int i = 0; i < n; i++) {\\n\\n        int target = -nums[i];\\n        Set<Integer> seen = new HashSet<>();\\n\\n        for (int j = i + 1; j < n; j++) {\\n\\n            int third = target - nums[j];\\n\\n            if (seen.contains(third)) {\\n\\n                List<Integer> triplet =\\n                        Arrays.asList(nums[i], nums[j], third);\\n\\n                Collections.sort(triplet);\\n\\n                uniqueTriplets.add(triplet);\\n            }\\n\\n            seen.add(nums[j]);\\n        }\\n    }\\n\\n    return new ArrayList<>(uniqueTriplets);\\n}\\n}","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":424},{"id":2029665446,"question_id":43,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781176661,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2029665446/","is_pending":"Not Pending","title":"Multiply Strings","memory":"43.4 MB","code":"class Solution {\\n    public String multiply(String num1, String num2) {\\n\\n        if(num1.equals(\\"0\\") || num2.equals(\\"0\\"))\\n            return \\"0\\";\\n\\n        int m = num1.length();\\n        int n = num2.length();\\n\\n        int[] result = new int[m + n];\\n\\n        for(int i = m - 1; i >= 0; i--) {\\n\\n            int d1 = num1.charAt(i) - \'0\';\\n\\n            for(int j = n - 1; j >= 0; j--) {\\n\\n                int d2 = num2.charAt(j) - \'0\';\\n\\n                int product = d1 * d2;\\n\\n                int pos = i + j + 1;\\n\\n                result[pos] += product;\\n            }\\n        }\\n\\n        // Handle carries\\n        for(int i = m + n - 1; i > 0; i--) {\\n            result[i - 1] += result[i] / 10;\\n            result[i] %= 10;\\n        }\\n\\n        StringBuilder sb = new StringBuilder();\\n\\n        int i = 0;\\n        while(i < result.length && result[i] == 0)\\n            i++;\\n\\n        while(i < result.length)\\n            sb.append(result[i++]);\\n\\n        return sb.toString();\\n    }\\n}","compare_result":"","title_slug":"multiply-strings","has_notes":false,"flag_type":1,"frontend_id":423},{"id":2029654726,"question_id":43,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781175897,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2029654726/","is_pending":"Not Pending","title":"Multiply Strings","memory":"N/A","code":"class Solution {\\n    public String multiply(String num1, String num2) {\\n        int a=0,b=0;\\n        for(int i=0;i<num1.length();i++) {\\n            int temp = num1.charAt(i)-\'0\';\\n            a = (a*10) + temp;\\n        }\\n        for(int i=0;i<num2.length();i++) {\\n            int temp = num2.charAt(i)-\'0\';\\n            b = (b*10) + temp;\\n        }\\n        int res = a*b;\\n        return String.valueOf(res);\\n    }\\n}","compare_result":"","title_slug":"multiply-strings","has_notes":false,"flag_type":1,"frontend_id":422},{"id":2029371363,"question_id":29,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781158705,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2029371363/","is_pending":"Not Pending","title":"Divide Two Integers","memory":"42.9 MB","code":"class Solution {\\n    public int divide(int dividend, int divisor) {\\n        if (dividend == Integer.MIN_VALUE && divisor == -1) {\\n            return Integer.MAX_VALUE;\\n        }\\n        boolean negative = (dividend < 0) ^ (divisor < 0);\\n        long dvd = Math.abs((long) dividend);\\n        long dvs = Math.abs((long) divisor);\\n        long ans = 0;\\n        for (int i = 31; i >= 0; i--) {\\n            if ((dvs << i) <= dvd) {\\n                dvd -= (dvs << i);\\n                ans += (1L << i);\\n            }\\n        }\\n        if (negative) {\\n            ans = -ans;\\n        }\\n        return (int) ans;\\n    }\\n}","compare_result":"","title_slug":"divide-two-integers","has_notes":false,"flag_type":1,"frontend_id":421},{"id":2028891033,"question_id":4007,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1781111465,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2028891033/","is_pending":"Not Pending","title":"Maximum Total Subarray Value II","memory":"N/A","code":"class Solution {\\n    public long maxTotalValue(int[] nums, int k) {\\n        long max = Integer.MIN_VALUE;\\n        long min = Integer.MAX_VALUE;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]>max)\\n                max = nums[i];\\n            if(nums[i]<min)\\n                min = nums[i];\\n        }\\n        return (max-min)*k;\\n    }\\n}","co