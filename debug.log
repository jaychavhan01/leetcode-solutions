;i--) {\\n            suffix[i] = suffix[i+1]*nums[i+1];\\n        }\\n        for(int i=0;i<len;i++) {\\n            nums[i] = prefix[i]*suffix[i];\\n        }\\n        return nums;\\n    }\\n}","compare_result":"111111111111111111111111","title_slug":"product-of-array-except-self","has_notes":false,"flag_type":1,"frontend_id":251},{"id":1991782429,"question_id":448,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777549435,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/1991782429/","is_pending":"Not Pending","title":"Find All Numbers Disappeared in an Array","memory":"66.9 MB","code":"class Solution {\\n    public List<Integer> findDisappearedNumbers(int[] nums) {\\n        ArrayList<Integer> res = new ArrayList<>();\\n        boolean ar[] = new boolean[nums.length+1];\\n\\n        for(int i = 0; i < nums.length; i++) {\\n            ar[nums[i]]= true;\\n        }\\n\\n        for(int i = 1; i < ar.length; i++) {\\n            if(ar[i]==false) {\\n                res.add(i);\\n            }\\n        }\\n        \\n        return res;\\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"find-all-numbers-disappeared-in-an-array","has_notes":false,"flag_type":1,"frontend_id":250},{"id":1991779258,"question_id":448,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777549063,"status":10,"status_display":"Accepted","runtime":"27 ms","url":"/submissions/detail/1991779258/","is_pending":"Not Pending","title":"Find All Numbers Disappeared in an Array","memory":"71.2 MB","code":"class Solution {\\n    public List<Integer> findDisappearedNumbers(int[] nums) {\\n        ArrayList<Integer> res = new ArrayList<>();\\n        Arrays.sort(nums);\\n\\n        // Step 1: Check before first element\\n        for(int i = 1; i < nums[0]; i++) {\\n            res.add(i);\\n        }\\n\\n        // Step 2: Check gaps in between\\n        for(int i = 0; i < nums.length - 1; i++) {\\n            if(nums[i] == nums[i+1]) continue;\\n\\n            int miss = nums[i] + 1;\\n            while(miss < nums[i+1]) {\\n                res.add(miss);\\n                miss++;\\n            }\\n        }\\n\\n        // Step 3: Check after last element\\n        for(int i = nums[nums.length - 1] + 1; i <= nums.length; i++) {\\n            res.add(i);\\n        }\\n\\n        return res;\\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"find-all-numbers-disappeared-in-an-array","has_notes":false,"flag_type":1,"frontend_id":249},{"id":1991262321,"question_id":231,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777486926,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1991262321/","is_pending":"Not Pending","title":"Power of Two","memory":"42.3 MB","code":"class Solution {\\n    public boolean isPowerOfTwo(int n) {\\n        // n must be positive and (n & (n - 1)) must be 0\\n        return n > 0 && (n & (n - 1)) == 0;\\n    }\\n}\\n","compare_result":"","title_slug":"power-of-two","has_notes":false,"flag_type":1,"frontend_id":248},{"id":1991261475,"question_id":231,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777486868,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1991261475/","is_pending":"Not Pending","title":"Power of Two","memory":"N/A","code":"class Solution {\\n    public boolean isPowerOfTwo(int n) {\\n     int res = n & n-1;\\n        if(res==0) return true;\\n        return false;\\n    }\\n}","compare_result":"","title_slug":"power-of-two","has_notes":false,"flag_type":1,"frontend_id":247},{"id":1990254047,"question_id":4290,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777383988,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1990254047/","is_pending":"Not Pending","title":"Valid Elements in an Array","memory":"46.8 MB","code":"import java.util.*;\\n\\nclass Solution {\\n    public List<Integer> findValidElements(int[] nums) {\\n        int n = nums.length;\\n        List<Integer> result = new ArrayList<>();\\n\\n        // Step 1: Build rightMax array\\n        int[] rightMax = new int[n];\\n        rightMax[n - 1] = Integer.MIN_VALUE;\\n\\n        for (int i = n - 2; i >= 0; i--) {\\n            rightMax[i] = Math.max(rightMax[i + 1], nums[i + 1]);\\n        }\\n\\n        // Step 2: Traverse and check conditions\\n        int maxLeft = Integer.MIN_VALUE;\\n\\n        for (int i = 0; i < n; i++) {\\n            if (\\n                i == 0 || \\n                i == n - 1 || \\n                nums[i] > maxLeft || \\n                nums[i] > rightMax[i]\\n            ) {\\n                result.add(nums[i]);\\n            }\\n\\n            maxLeft = Math.max(maxLeft, nums[i]);\\n        }\\n\\n        return result;\\n    }\\n}","compare_result":"","title_slug":"valid-elements-in-an-array","has_notes":false,"flag_type":1,"frontend_id":246}],"has_next":true,"last_key":""}'
