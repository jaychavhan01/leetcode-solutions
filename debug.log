n        }\\n        return count;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"number-of-strings-that-appear-as-substrings-in-word","has_notes":false,"flag_type":1,"frontend_id":504},{"id":2049260521,"question_id":4007,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months","timestamp":1782671092,"status":10,"status_display":"Accepted","runtime":"84 ms","url":"/submissions/detail/2049260521/","is_pending":"Not Pending","title":"Maximum Total Subarray Value II","memory":"148.1 MB","code":"class Solution {\\n    public long maxTotalValue(int[] nums, int k) {\\n        int n = nums.length;\\n        int logN = (int) (Math.log(n)/Math.log(2))+1;\\n        int[][] max = new int[logN][n];\\n        int[][] min = new int[logN][n];\\n\\n        for(int i=0;i<n;i++) {\\n            max[0][i] = nums[i];\\n            min[0][i] = nums[i];\\n        }\\n\\n        for(int j=1;j<logN;j++) {\\n            for(int i=0;i+(1<<j)<=n;i++) {\\n                max[j][i] = Math.max(max[j - 1][i], max[j - 1][i + (1 << (j - 1))]);\\n                min[j][i] = Math.min(min[j - 1][i], min[j - 1][i + (1 << (j - 1))]);\\n            }\\n        }\\n        int[] logs = new int[n+1];\\n        for(int i=2;i<=n;i++) {\\n            logs[i] = logs[i/2]+1;\\n        }\\n        PriorityQueue<long[]> pq = new PriorityQueue<>((a,b)->Long.compare(b[0],a[0]));\\n\\n        for(int i=0;i<n;i++) {\\n            pq.offer(new long[]{getVal(i,n-1,max,min,logs),i,n-1});\\n        }\\n        long totalValue = 0;\\n        for (int i = 0; i < k; i++) {\\n            long[] top = pq.poll();\\n            totalValue += top[0];\\n            int l = (int) top[1];\\n            int r = (int) top[2];\\n            \\n            if (r > l) {\\n                pq.offer(new long[]{getVal(l, r - 1, max, min, logs), l, r - 1});\\n            }\\n        }\\n        \\n        return totalValue;\\n    }\\n\\n    private long getVal(int l, int r, int[][] maxST, int[][] minST, int[] logs) {\\n        int j = logs[r - l + 1];\\n        int maxVal = Math.max(maxST[j][l], maxST[j][r - (1 << j) + 1]);\\n        int minVal = Math.min(minST[j][l], minST[j][r - (1 << j) + 1]);\\n        return (long) maxVal - minVal;\\n    }\\n}","compare_result":"","title_slug":"maximum-total-subarray-value-ii","has_notes":false,"flag_type":1,"frontend_id":503},{"id":2048913485,"question_id":48,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782648586,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2048913485/","is_pending":"Not Pending","title":"Rotate Image","memory":"44.1 MB","code":"class Solution {\\n    public void rotate(int[][] matrix) {\\n        int col = matrix[0].length-1;\\n        for(int i=0;i<matrix.length;i++) {\\n            for(int j=i+1;j<matrix[0].length;j++) {\\n                int temp = matrix[i][j];\\n                matrix[i][j] = matrix[j][i];\\n                matrix[j][i] = temp;\\n            }\\n        }\\n        for(int i=0;i<matrix.length;i++) {\\n            int st = 0;\\n            int end = col;\\n            while(st<end) {\\n                int temp = matrix[i][st];\\n                matrix[i][st] = matrix[i][end];\\n                matrix[i][end] = temp;\\n                st++;\\n                end--;\\n            }\\n        }\\n\\n    }\\n}","compare_result":"111111111111111111111","title_slug":"rotate-image","has_notes":false,"flag_type":1,"frontend_id":502},{"id":2048109872,"question_id":227,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782581869,"status":10,"status_display":"Accepted","runtime":"21 ms","url":"/submissions/detail/2048109872/","is_pending":"Not Pending","title":"Basic Calculator II","memory":"48.4 MB","code":"class Solution {\\n    public int calculate(String s) {\\n        Stack<Integer> stack = new Stack<>();\\n        int num = 0;\\n        char lo = \'+\';\\n        for(int i=0;i<s.length();i++) {\\n            char c = s.charAt(i);\\n\\n            if(Character.isDigit(c)) {\\n                num = 10*num+(c-\'0\');\\n            }\\n            \\n            if((!Character.isDigit(c) && c!=\' \')|| i==s.length()-1) {\\n                if(lo == \'+\') stack.push(num);\\n                else if(lo==\'-\') stack.push(-num);\\n                else if(lo==\'*\') stack.push(stack.pop()*num);\\n                else if(lo==\'/\') stack.push(stack.pop()/num);\\n                lo=c;\\n                num=0;\\n            }\\n        }\\n        int res=0;\\n        for(int i:stack) {\\n            res += i;\\n        }\\n        return res;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"basic-calculator-ii","has_notes":false,"flag_type":1,"frontend_id":501},{"id":2048032206,"question_id":166,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782577437,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2048032206/","is_pending":"Not Pending","title":"Fraction to Recurring Decimal","memory":"42.6 MB","code":"class Solution {\\n    public String fractionToDecimal(int numerator, int denominator) {\\n        if(numerator==0) return \\"0\\";\\n\\n        StringBuilder res = new StringBuilder();\\n        if((numerator<0)^(denominator<0)) {\\n            res.append(\\"-\\");\\n        }\\n        long n = Math.abs((long)numerator);\\n        long d = Math.abs((long)denominator);\\n\\n        res.append(n/d);\\n\\n        long rem = n%d;\\n        if(rem==0) {\\n            return res.toString();\\n        }\\n\\n        res.append(\\".\\");\\n\\n        Map<Long, Integer> map = new HashMap<>();\\n\\n        while(rem!=0) {\\n            if(map.containsKey(rem)) {\\n                res.insert(map.get(rem),\\"(\\");\\n                res.append(\\")\\");\\n                break;\\n            }\\n\\n            map.put(rem,res.length());\\n\\n            rem *= 10;\\n            res.append(rem/d);\\n            rem %= d;\\n        }\\n        return res.toString();\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111","title_slug":"fraction-to-recurring-decimal","has_notes":false,"flag_type":1,"frontend_id":500},{"id":2048011243,"question_id":224,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782576113,"status":10,"status_display":"Accepted","runtime":"10 ms","url":"/submissions/detail/2048011243/","is_pending":"Not Pending","title":"Basic Calculator","memory":"46.1 MB","code":"class Solution {\\n    public int calculate(String s) {\\n        Stack<Integer> stack = new Stack<>();\\n        int sign = 1;\\n        int res = 0;\\n        int num = 0;\\n\\n        for(int i=0;i<s.length();i++) {\\n            char c = s.charAt(i);\\n\\n            if(Character.isDigit(c)) {\\n                num = 10*num+(c-\'0\');\\n            }\\n            else if(c==\'+\') {\\n                res += sign*num;\\n                num = 0;\\n                sign = 1;\\n            }\\n            else if(c==\'-\') {\\n                res += sign*num;\\n                num = 0;\\n                sign = -1;\\n            }\\n            else if(c==\'(\') {\\n                stack.push(res);\\n                stack.push(sign);\\n                res=0;\\n                sign=1;\\n            }\\n            else if(c==\')\') {\\n                res += sign*num;\\n                num=0;\\n                res *= stack.pop();\\n                res += stack.pop();\\n            }\\n        }\\n        res += sign*num;\\n        return res;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"basic-calculator","has_notes":false,"flag_type":1,"frontend_id":499},{"id":2048001737,"question_id":223,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782575497,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2048001737/","is_pending":"Not Pending","title":"Rectangle Area","memory":"44.5 MB","code":"class Solution {\\n    public int computeArea(int ax1, int ay1, int ax2, int ay2, int bx1, int by1, int bx2, int by2) {\\n        int ar1 = (ax2-ax1)*(ay2-ay1);\\n        int ar2 = (bx2-bx1)*(by2-by1);\\n\\n        int left = Math.max(ax1,bx1);\\n        int right = Math.min(ax2,bx2);\\n        int bottom = Math.max(ay1,by1);\\n        int top = Math.min(ay2,by2);\\n\\n        int width = Math.max(0,right-left);\\n        int height = Math.max(0,top-bottom);\\n\\n        int extra = width * height;\\n\\n        return ar1+ar2-extra;\\n    }\\n}","compare_result":"","title_slug":"rectangle-area","has_notes":false,"flag_type":1,"frontend_id":498},{"id":2047123879,"question_id":22,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782497153,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2047123879/","is_pending":"Not Pending","title":"Generate Parentheses","memory":"44.8 MB","code":"class Solution {\\n    public List<String> generateParenthesis(int n) {\\n        List<String> res = new ArrayList<>();\\n        backtrack(res,\\"\\",0,0,n);\\n        return res;\\n    }\\n    private void backtrack(List<String> res,String curr,int open,int close,int n) {\\n        if(curr.length()==2*n) {\\n            res.add(curr);\\n            return;\\n        }\\n        \\n        if(open<n) {\\n            backtrack(res,curr+\\"(\\",open+1,close,n);\\n        }\\n        \\n        if(close<open) {\\n            backtrack(res,curr+\\")\\",open,close+1,n);\\n        }\\n    }\\n}","compare_result":"11111111","title_slug":"generate-parentheses","has_notes":false,"flag_type":1,"frontend_id":497},{"id":2047114420,"question_id":974,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782496644,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2047114420/","is_pending":"Not Pending","title":"Reorder Data in Log Files","memory":"46.3 MB","code":"class Solution {\\n    public String[] reorderLogFiles(String[] logs) {\\n        Arrays.sort(logs,(a,b) -> {\\n            int ind1 = a.indexOf(\' \');\\n            int ind2 = b.indexOf(\' \');\\n            String id1 = a.substring(0,ind1);\\n            String id2 = b.substring(0,ind2);\\n            \\n            String content1 = a.substring(ind1+1);\\n            String content2 = b.substring(ind2+1);\\n            \\n            boolean isDigit1 = Character.isDigit(content1.charAt(0));\\n            boolean isDigit2 = Character.isDigit(content2.charAt(0));\\n            \\n            if(!isDigit1 && !isDigit2) {\\n                int cmp = content1.compareTo(content2);\\n                if(cmp!=0) return cmp;\\n                return id1.compareTo(id2);\\n            }\\n            \\n            if(!isDigit1 && isDigit2) return -1;\\n            \\n            if(isDigit1 && !isDigit2) return 1;\\n            \\n            return 0;\\n        });\\n        return logs;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111","title_slug":"reorder-data-in-log-files","has_notes":false,"flag_type":1,"frontend_id":496},{"id":2047099498,"question_id":596,"lang":"mysql","lang_name":"MySQL","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782495835,"status":10,"status_display":"Accepted","runtime":"469 ms","url":"/submissions/detail/2047099498/","is_pending":"Not Pending","title":"Classes With at Least 5 Students","memory":"0.0B","code":"# Write your MySQL query statement below\\nselect class from Courses group by class having count(distinct student)>=5;","compare_result":"11111111111","title_slug":"classes-with-at-least-5-students","has_notes":false,"flag_type":1,"frontend_id":495}