2026-10-05 18:59:55,226 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":2120385590,"question_id":3150,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787721166,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2120385590/","is_pending":"Not Pending","title":"Shortest and Lexicographically Smallest Beautiful String","memory":"44.4 MB","code":"class Solution {\\n    public String shortestBeautifulSubstring(String s, int k) {\\n        int left =0;\\n        int count = 0;\\n        String res = \\"\\";\\n\\n        for(int right=0;right<s.length();right++) {\\n            if(s.charAt(right)==\'1\') {\\n                count++;\\n            }\\n            while(left<=right && (count>k || s.charAt(left)==\'0\')) {\\n                if(s.charAt(left)==\'1\') {\\n                    count--;\\n                }\\n                left++;\\n            }\\n\\n            if(count==k) {\\n                String current = s.substring(left,right+1);\\n                if(res.isEmpty()||current.length()<res.length()||\\n                (current.length()==res.length()&& current.compareTo(res) <0))\\n                res=current;\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"shortest-and-lexicographically-smallest-beautiful-string","has_notes":false,"flag_type":1,"frontend_id":626},{"id":2119959721,"question_id":4080,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787678418,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2119959721/","is_pending":"Not Pending","title":"Smallest Missing Multiple of K","memory":"45.7 MB","code":"class Solution {\\n    public int missingMultiple(int[] nums, int k) {\\n        HashSet<Integer> set = new HashSet<>();\\n        for(int val:nums) {\\n            set.add(val);\\n        }\\n        int st=1;\\n        while(set.contains(st*k)) {\\n        