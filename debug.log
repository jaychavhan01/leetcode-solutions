 Solution {\\n    public List<Integer> findMissingElements(int[] nums) {\\n        List<Integer> res = new ArrayList<>();\\n        int max=nums[0];\\n        int min=nums[0];\\n        for(int num:nums) {\\n            if(num>max) max=num;\\n            if(num<min) min=num;\\n        }\\n        Set<Integer> ele = new HashSet<>();\\n        for(int num:nums) {\\n            ele.add(num);\\n        }\\n        for(int i=min+1;i<max;i++) {\\n            if(!ele.contains(i)) res.add(i);\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-missing-elements","has_notes":false,"flag_type":1,"frontend_id":592},{"id":2094314836,"question_id":4107,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months","timestamp":1785862134,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2094314836/","is_pending":"Not Pending","title":"Find Missing Elements","memory":"N/A","code":"class Solution {\\n    public List<Integer> findMissingElements(int[] nums) {\\n        List<Integer> res = new ArrayList<>();\\n        int max=0;\\n        int min=101;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]>max) max=nums[i];\\n            else if(nums[i]<min) min=nums[i];\\n        }\\n        int ar[] = new int[max+1];\\n        for(int i=0;i<nums.length;i++) {\\n            ar[nums[i]]++;\\n        }\\n        for(int i=min+1;i<max;i++) {\\n            if(ar[i]==0) res.add(i);\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-missing-elements","has_notes":false,"flag_type":1,"frontend_id":591},{"id":2094308512,"question_id":4107,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months","timestamp":1785861900,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2094308512/","is_pending":"Not Pending","title":"Find Missing Elements","memory":"47.3 MB","code":"class Solution {\\n    public List<Integer> findMissingElements(int[] nums) {\\n     