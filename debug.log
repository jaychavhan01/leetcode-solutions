urn (int)max;\\n\\n        return (int)max3;\\n    }\\n}","compare_result":"1111111111111111111111111111111111","title_slug":"third-maximum-number","has_notes":false,"flag_type":1,"frontend_id":257},{"id":1996023338,"question_id":283,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1778001947,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/1996023338/","is_pending":"Not Pending","title":"Move Zeroes","memory":"47.7 MB","code":"class Solution {\\n    public void moveZeroes(int[] nums) {\\n        int pos = 0;\\n\\n        for (int i = 0; i < nums.length; i++) {\\n            if (nums[i] != 0) {\\n                int temp = nums[i];\\n                nums[i] = nums[pos];\\n                nums[pos] = temp;\\n                pos++;\\n            }\\n        }\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"move-zeroes","has_notes":false,"flag_type":1,"frontend_id":256},{"id":1994740277,"question_id":560,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777877093,"status":10,"status_display":"Accepted","runtime":"1533 ms","url":"/submissions/detail/1994740277/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"48.7 MB","code":"class Solution {\\n    public int subarraySum(int[] nums, int k) {\\n        int count=0;\\n        for(int i=0;i<nums.length;i++) {\\n            int sum = 0;\\n            for(int j=i;j<nums.length;j++) {\\n                sum += nums[j];\\n                if(sum==k) count++;\\n            }\\n        }\\n        return count;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":255},{"id":1994047440,"question_id":812,"lang":"java","lang_name":"Java","time":"5\xc2\xa0months","timestamp":1777800187,"status":10