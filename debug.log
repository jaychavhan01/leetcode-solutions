ow];\\n                nums[low] = temp;\\n                mid++;\\n                low++;\\n            }\\n            else if(nums[mid]==1) {\\n                mid++;\\n            }\\n            else {\\n                int temp = nums[mid];\\n                nums[mid] = nums[high];\\n                nums[high] = temp;\\n                high--;\\n            }\\n        }\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":413},{"id":2025317706,"question_id":75,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780833086,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2025317706/","is_pending":"Not Pending","title":"Sort Colors","memory":"43.4 MB","code":"class Solution {\\n    public void sortColors(int[] nums) {\\n        int cnt0=0,cnt1=0,cnt2=0;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]==0) cnt0++;\\n            else if(nums[i]==1) cnt1++;\\n            else cnt2++;\\n        }\\n        int ind = 0;\\n        while(cnt0>0) {\\n            nums[ind++] = 0;\\n            cnt0--;\\n        }\\n        while(cnt1>0) {\\n            nums[ind++] = 1;\\n            cnt1--;\\n        }\\n        while(cnt2>0) {\\n            nums[ind++] = 2;\\n            cnt2--;\\n        }\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":412},{"id":2025310740,"question_id":11,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780832545,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2025310740/","is_pending":"Not Pending","title":"Container With Most Water","memory":"77.3 MB","code":"class Solution {\\n    public int maxArea(int[] height) {\\n        int max=0;\\n        int left = 0;\\n        int right = height.length-1;\\n        while(left<right) {\\n            int w = right-left;\\n            int h = Math.min(height[left],height[right]);\\n            max = Math.max(max,h*w);\\n            if(height[left]<height[right]) \\n                left++;\\n            else\\n                right--;\\n        }\\n        return max;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"container-with-most-water","has_notes":false,"flag_type":1,"frontend_id":411},{"id":2025309275,"question_id":11,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780832432,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2025309275/","is_pending":"Not Pending","title":"Container With Most Water","memory":"77.2 MB","code":"class Solution {\\n    public int maxArea(int[] height) {\\n        int n = height.length;\\n        int max=Integer.MIN_VALUE;\\n        int left = 0;\\n        int right = n-1;\\n        while(left<right) {\\n            int w = right-left;\\n            int h = Math.min(height[left],height[right]);\\n            max = Math.max(max,h*w);\\n            if(height[left]<height[right]) \\n                left++;\\n            else\\n                right--;\\n        }\\n        return max;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"container-with-most-water","has_notes":false,"flag_type":1,"frontend_id":410},{"id":2025301337,"question_id":11,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780831814,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2025301337/","is_pending":"Not Pending","title":"Container With Most Water","memory":"N/A","code":"class Solution {\\n    public int maxArea(int[] height) {\\n        int 