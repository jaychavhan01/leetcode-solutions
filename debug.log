cepted","runtime":"2 ms","url":"/submissions/detail/2060075934/","is_pending":"Not Pending","title":"Majority Element II","memory":"52.6 MB","code":"class Solution {\\n    public List<Integer> majorityElement(int[] nums) {\\n        List<Integer> res = new ArrayList<>();\\n        int cand1 = 0,cand2=1,count1=0,count2=0;\\n        for (int num : nums) {\\n        if (num == cand1) count1++;\\n        else if (num == cand2) count2++;\\n        else if (count1 == 0) { cand1 = num; count1 = 1; }\\n        else if (count2 == 0) { cand2 = num; count2 = 1; }\\n        else { count1--; count2--; }\\n        }\\n        count1=0;\\n        count2=0;\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]==cand1) count1++;\\n            else if(nums[i]==cand2) count2++;\\n        }\\n        if(count1>nums.length/3) res.add(cand1);\\n        if(count2>nums.length/3) res.add(cand2);\\n        return res;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"majority-element-ii","has_notes":false,"flag_type":1,"frontend_id":519},{"id":2058984779,"question_id":4135,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1783410909,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2058984779/","is_pending":"Not Pending","title":"Concatenate Non-Zero Digits and Multiply by Sum I","memory":"42.5 MB","code":"class Solution {\\n    public long sumAndMultiply(int n) {\\n        long temp=n;\\n        long rev=0;\\n        int sum=0;\\n        while(temp>0) {\\n            long ld = temp%10;\\n            if(ld!=0) {\\n                rev = rev*10 +ld;\\n                sum += ld;\\n            }\\n            temp /= 10;\\n        }\\n        temp=0;\\n        while(rev>0) {\\n            temp = temp*10 + rev%10;\\n            rev /=10;\\n        }\\n        return temp*sum;\\n    }\\n}","compare_result":"","title_slug":"concatenate-non-zero-digits-and-multiply-by-sum-i","has_notes":false,"flag_type":1,"frontend_id":518},{"id":2058976758,"question_id":567,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1783410403,"status":10,"status_display":"Accepted","runtime":"184 ms","url":"/submissions/detail/2058976758/","is_pending":"Not Pending","title":"Permutation in String","memory":"47 MB","code":"class Solution {\\n    public boolean checkInclusion(String s1, String s2) {\\n        int freq[]=new int[26];\\n        for(int i=0;i<s1.length();i++) {\\n            int ind = s1.charAt(i)-\'a\';\\n            freq[ind]++;\\n        }\\n        int size=s1.length();\\n        for(int i=0;i<s2.length();i++) {\\n            int wind=0,ind=i;\\n            int win[]=new int[26];\\n            while(wind<size && ind<s2.length()) {\\n                win[s2.charAt(ind)-\'a\']++;\\n                wind++;\\n                ind++;\\n            }\\n            if((Arrays.equals(win,freq))) return true;\\n        }\\n        return false;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"permutation-in-string","has_notes":false,"flag_type":1,"frontend_id":517},{"id":2057700213,"question_id":303,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1783321674,"status":10,"status_display":"Accepted","runtime":"55 ms","url":"/submissions/detail/2057700213/","is_pending":"Not Pending","title":"Range Sum Query - Immutable","memory":"47.4 MB","code":"class NumArray {\\n    int ar[];\\n    public NumArray(int[] nums) {\\n        ar=nums;\\n    }\\n    \\n    public int sumRange(int left, int right) {\\n        int sum=0;\\n        for(int i=left;i<=right;i++) {\\n            sum += ar[i];\\n        }\\n        return sum;\\n    }\\n}\\n\\n/**\\n * Your NumArray object will be instantiated and called as such:\\n * NumArray obj = new Nu