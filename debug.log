n] != null) {\\n            return memo[r][c][open];\\n        }\\n        boolean foundPath = false;\\n        if (r + 1 < m) {\\n            foundPath = dfs(grid, r + 1, c, open);\\n        }\\n        if (!foundPath && c + 1 < n) {\\n            foundPath = dfs(grid, r, c + 1, open);\\n        }\\n        return memo[r][c][open] = foundPath;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"check-if-there-is-a-valid-parentheses-string-path","has_notes":false,"flag_type":1,"frontend_id":641},{"id":2155679499,"question_id":1737,"lang":"java","lang_name":"Java","time":"1\xc2\xa0week","timestamp":1790578295,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2155679499/","is_pending":"Not Pending","title":"Maximum Nesting Depth of the Parentheses","memory":"42.6 MB","code":"class Solution {\\n    public int maxDepth(String s) {\\n        int max = 0;\\n        int count=0;\\n        for(int i=0;i<s.length();i++) {\\n            if(s.charAt(i)==\'(\') count++;\\n            else if(s.charAt(i)==\')\') count--;\\n            max = Math.max(count,max);\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"maximum-nesting-depth-of-the-parentheses","has_notes":false,"flag_type":1,"frontend_id":640},{"id":2134972418,"question_id":182,"lang":"mysql","lang_name":"MySQL","time":"3\xc2\xa0weeks, 6\xc2\xa0days","timestamp":1788862649,"status":10,"status_display":"Accepted","runtime":"374 ms","url":"/submissions/detail/2134972418/","is_pending":"Not Pending","title":"Duplicate Emails","memory":"0.0B","code":"# Write your MySQL query statement below\\nselect email as Email from Person group by email having count(email)>1;","compare_result":"111111111111111","title_slug":"duplicate