"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2084521179/","is_pending":"Not Pending","title":"Maximum Difference Between Even and Odd Frequency I","memory":"43.6 MB","code":"class Solution {\\n    public int maxDifference(String s) {\\n        int freq[] = new int[26];\\n        for(int i=0;i<s.length();i++) {\\n            freq[s.charAt(i)-97]++;\\n        }\\n        int odd=Integer.MIN_VALUE;\\n        int even=Integer.MAX_VALUE;\\n        for(int i=0;i<freq.length;i++) {\\n            if(freq[i]%2==0 && freq[i]!=0) {\\n               even=Math.min(freq[i],even);\\n            }\\n            else {\\n                if(freq[i]!=0) odd=Math.max(freq[i],odd);\\n            }\\n        }\\n        return odd-even;\\n    }\\n}","compare_result":"","title_slug":"maximum-difference-between-even-and-odd-frequency-i","has_notes":false,"flag_type":1,"frontend_id":575},{"id":2084422974,"question_id":3753,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785225339,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2084422974/","is_pending":"Not Pending","title":"Maximum Difference Between Even and Odd Frequency I","memory":"N/A","code":"class Solution {\\n    public int maxDifference(String s) {\\n        int freq[] = new int[26];\\n        for(int i=0;i<s.length();i++) {\\n            freq[s.charAt(i)-97]++;\\n        }\\n        int even=0;\\n        int odd=0;\\n        for(int i=0;i<freq.length;i++) {\\n            if(freq[i]%2==0 && freq[i]>even) {\\n                even=freq[i];\\n            }\\n            else {\\n                if(freq[i]>odd) odd=freq[i];\\n            }\\n        }\\n        return odd-even;\\n        //return Math.max(even-odd,odd-even);\\n    }\\n}","compare_result":"","title_slug":"maximum-difference-between-even-and-odd-frequency-i","has_notes":false,"flag_type":1,"frontend_id":574},{"id":2084421254,"question_id":3753,"lang":"java","lang_name