    }\\n        return res.toString();\\n    }\\n}","compare_result":"","title_slug":"zigzag-conversion","has_notes":false,"flag_type":1,"frontend_id":567},{"id":2083406095,"question_id":5,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785159274,"status":10,"status_display":"Accepted","runtime":"2578 ms","url":"/submissions/detail/2083406095/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"47 MB","code":"class Solution {\\n    public boolean isPalindrome(String s) {\\n        int st=0,end=s.length()-1;\\n        while(st<end) {\\n            if(s.charAt(st)!=s.charAt(end)) return false;\\n            st++;\\n            end--;\\n        }\\n        return true;\\n    }\\n    public String longestPalindrome(String s) {\\n        int max=0;\\n        String ans=\\"\\";\\n        for(int i=0;i<s.length();i++) {\\n            for(int j=i;j<s.length();j++) {\\n                String str = s.substring(i,j+1);\\n                boolean res = isPalindrome(str);\\n                if(res && str.length()>max) {\\n                    ans=str;\\n                    max=str.length();\\n                }\\n            }\\n        }\\n        return ans;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":566}],"has_next":true,"last_key":""}'
