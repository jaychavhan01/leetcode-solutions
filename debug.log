:"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785223738,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2084397701/","is_pending":"Not Pending","title":"Sum of Elements With Frequency Divisible by K","memory":"44.3 MB","code":"class Solution {\\n    public int sumDivisibleByK(int[] nums, int k) {\\n        int ar[] = new int[101];\\n        for(int val:nums) {\\n            ar[val]++;\\n        }\\n        int res=0;\\n        for(int i=1;i<ar.length;i++) {\\n            if(ar[i]!=0 && ar[i]%k==0) {\\n                res = res + ar[i]*i;\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"sum-of-elements-with-frequency-divisible-by-k","has_notes":false,"flag_type":1,"frontend_id":571},{"id":2084390551,"question_id":2053,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785223309,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2084390551/","is_pending":"Not Pending","title":"Check if All Characters Have Equal Number of Occurrences","memory":"43.4 MB","code":"class Solution {\\n    public boolean areOccurrencesEqual(String s) {\\n        int freq[] = new int[26];\\n        for(int i=0;i<s.length();i++) {\\n            freq[s.charAt(i)-97]++;\\n        }\\n        int occ=freq[s.charAt(0)-97];\\n        for(int i=0;i<freq.length;i++) {\\n            if(freq[i]!=0 && freq[i]!=occ) return false;\\n        }\\n        return true;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"check-if-all-characters-have-equal-number-of-occurrences","has_notes":false,"flag_type":1,"frontend_id":570},{"id":2084376930,"question_id":1786,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785222548,"status":10,"status_display":"Accepted","runtime":"12 ms","url":"/submissions/detail/2084376930/","is_pending":"Not Pending","title":"Count the Number of Consistent Strings","memory":"47.2 MB","code":"class Solution {\\n    public int countConsistentStrings(String allowed, String[] words) {\\n        int totalCount=0;\\n        char ar[] = allowed.toCharArray();\\n        for(String str: words) {\\n            int count=0;\\n            for(int i=0;i<str.length();i++) {\\n                char ch = str.charAt(i);\\n                for(int j=0;j<ar.length;j++) {\\n                    if(ch==ar[j]) {\\n                        count++;\\n                        break;\\n                    }\\n                }\\n            }\\n            if(count==str.length()) totalCount++;\\n        }\\n        return totalCount;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"count-the-number-of-consistent-strings","has_notes":false,"flag_type":1,"frontend_id":569},{"id":2084356420,"question_id":1510,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785221545,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2084356420/","is_pending":"Not Pending","title":"Find Lucky Integer in an Array","memory":"45.1 MB","code":"class Solution {\\n    public int findLucky(int[] arr) {\\n        int freq[] = new int[501];\\n        for(int val:arr) {\\n            freq[val]++;\\n        }\\n        int max=-1;\\n        for(int i=1;i<freq.length;i++) {\\n            if(freq[i]==i && freq[i]>max) {\\n                max=i;\\n            }\\n        }\\n        return max;\\n    }\\n}","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-lucky-integer-in-an-array","has_notes":false,"flag_type":1,"frontend_id":568},{"id":2083421444,"question_id":6,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1785159985,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2083421444/","is_pending":"Not Pending","title":"Zigzag Conversion","memory":"46.7 MB","code":"class Solution {\\n    public String convert(String s, int numRows) {\\n        if(numRows==1||numRows>=s.length()) {\\n            return s;\\n        }\\n        StringBuilder rows[] = new StringBuilder[Math.min(s.length(),numRows)];\\n        for(int i=0;i<rows.length;i++) {\\n            rows[i]=new StringBuilder();\\n        }\\n        int cRow=0;\\n        boolean gDown=false;\\n\\n        for(char c:s.toCharArray()) {\\n            rows[cRow].append(c);\\n            if(cRow==0||cRow==numRows-1) gDown=!gDown;\\n            cRow += gDown?1:-1;\\n        }\\n        StringBuilder res = new StringBuilder();\\n        for(StringBuilder row : rows) {\\n            res.append(row);\\n        }\\n        return res.toString();\\n    }\\n}","compare_result":"","title_slug":"zigzag-conversion","has_notes":false,"flag_type":1,"frontend_id":567}],"has_next":true,"last_key":""}'
