ome Number","memory":"45.9 MB","code":"class Solution {\\n    public boolean isPalindrome(int x) {\\n        int temp = x;\\n        int rev = 0;\\n        while(temp>0) {\\n            rev = (rev * 10) + temp % 10;\\n            temp /= 10; \\n        }\\n        if(rev==x) return true;\\n        return false; \\n    }\\n}","compare_result":"","title_slug":"palindrome-number","has_notes":false,"flag_type":1,"frontend_id":348},{"id":2011599180,"question_id":2571,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779615589,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2011599180/","is_pending":"Not Pending","title":"Find the Pivot Integer","memory":"42.4 MB","code":"class Solution {\\n    public int pivotInteger(int n) {\\n        \\n        int totalSum = n * (n + 1) / 2;\\n        \\n        int x = (int)Math.sqrt(totalSum);\\n        \\n        // Check if totalSum is a perfect square\\n        if (x * x == totalSum) {\\n            return x;\\n        }\\n        \\n        return -1;\\n    }\\n}","compare_result":"","title_slug":"find-the-pivot-integer","has_notes":false,"flag_type":1,"frontend_id":347}],"has_next":true,"last_key":""}'
