"/submissions/detail/2078216303/","is_pending":"Not Pending","title":"Check if Any Element Has Prime Frequency","memory":"44.3 MB","code":"class Solution {\\n    public boolean checkPrime(int n) {\\n        if(n==2) return true;\\n        for(int i=2;i<n;i++) {\\n            if(n%i==0) return false;\\n        }\\n        return true;\\n    }\\n    public boolean checkPrimeFrequency(int[] nums) {\\n        int ar[] = new int[101];\\n        for(int val:nums) {\\n            ar[val]++;\\n        }\\n        for(int val:ar) {\\n            if(val>1) {\\n                boolean res=checkPrime(val);\\n                if(res) return true;\\n            }\\n        }\\n        return false;\\n    }\\n}","compare_result":"","title_slug":"check-if-any-element-has-prime-frequency","has_notes":false,"flag_type":1,"frontend_id":555},{"id":2078207155,"question_id":3994,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1784799590,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2078207155/","is_pending":"Not Pending","title":"Find The Least Frequent Digit","memory":"42.1 MB","code":"class Solution {\\n    public int getLeastFrequentDigit(int n) {\\n        int ar[] = new int[10];\\n        while(n>0) {\\n            int ld = n%10;\\n            ar[ld]++;\\n            n/=10;\\n        }\\n        int min=Integer.MAX_VALUE;\\n        for(int i=0;i<ar.length;i++) {\\n            if(ar[i]<min && ar[i]!=0) {\\n                min=ar[i];\\n            }\\n        }\\n        for(int i=0;i<ar.length;i++) {\\n            if(ar[i]==min && min!=0) {\\n                return i;\\n            }\\n        }\\n        return -1;\\n    }\\n}","compare_result":"","title_slug":"find-the-least-frequent-digit","has_notes":false,"flag_type":1,"frontend_id":554},{"id":2076802287,"question_id":4231,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1784706103,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2076802287/","is_pending":"Not Pending","title":"Smallest Pair With Different Frequencies","memory":"47 MB","code":"class Solution {\\n    public int[] minDistinctFreqPair(int[] nums) {\\n        int ar[] = new int[101];\\n        for(int val:nums) {\\n            ar[val]++;\\n        }\\n        int freq=-1;\\n        for(int i=1;i<ar.length;i++) {\\n            if(ar[i]==0) continue;\\n            int freq1 = ar[i];\\n\\n            for (int j = i + 1; j <= 100; j++) {\\n                if (ar[j] != 0 && ar[j] != freq1) {\\n                    return new int[]{i, j};\\n                }\\n            }\\n        }\\n        return new int[]{-1,-1};\\n    }\\n}","compare_result":"","title_slug":"smallest-pair-with-different-frequencies","has_notes":false,"flag_type":1,"frontend_id":553},{"id":2076787507,"question_id":4252,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1784705110,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2076787507/","is_pending":"Not Pending","title":"First Unique Even Element","memory":"46.2 MB","code":"class Solution {\\n    public int firstUniqueEven(int[] nums) {\\n        int ar[] = new int[101];\\n        for(int i=0;i<nums.length;i++) {\\n            ar[nums[i]]++;\\n        }\\n        for(int i=0;i<nums.length;i++) {\\n            if(nums[i]%2==0 && ar[nums[i]]==1)\\n                return nums[i]; \\n        }\\n        return -1;\\n    }\\n}","compare_result":"","title_slug":"first-unique-even-element","has_notes":false,"flag_type":1,"frontend_id":552},{"id":2076773474,"question_id":2377,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1784704278,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2076773474/","is_pending":"Not Pending","title":"Check if Number Has Equal Digit Count and Digit Value","memory":"43.1 MB","code":"class Solution {\\n   