i<nums.length;i++) {\\n\\n            prefix[i]=prefix[i-1];\\n\\n            if(nums[i]%2==nums[i-1]%2) {\\n                prefix[i]++;\\n            }\\n        }\\n\\n            for(int i=0;i<len;i++) {\\n                int st = queries[i][0];\\n                int end = queries[i][1];\\n\\n                res[i] = (prefix[end]-prefix[st]==0);\\n            }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"valid-k-unique-subarrays-i","has_notes":false,"flag_type":1,"frontend_id":623},{"id":2116845431,"question_id":4383,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787456170,"status":10,"status_display":"Accepted","runtime":"93 ms","url":"/submissions/detail/2116845431/","is_pending":"Not Pending","title":"Find All Numbers Disappeared in an Array II","memory":"175.8 MB","code":"class Solution {\\n    public List<List<Integer>> findDisappearedNumbers(int[] nums, int lower, int upper) {\\n        List<List<Integer>> res = new ArrayList<>();\\n        Set<Integer> set = new HashSet<>();\\n\\n        for(int num:nums) {\\n            set.add(num);\\n        }\\n        int i = lower;\\n        while(i<=upper) {\\n            if(set.contains(i)) {\\n                i++;\\n                continue;\\n            }\\n            int start = i;\\n\\n            while(i<=upper && !set.contains(i)) {\\n                i++;\\n            }\\n            int end = i-1;\\n            res.add(Arrays.asList(start,end));\\n        }\\n        return res;\\n    }\\n}","compare_result":"","title_slug":"find-all-numbers-disappeared-in-an-array-ii","has_notes":false,"flag_type":1,"frontend_id":622},{"id":2116830969,"question_id":4381,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787455665,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2116830969/","is_pending":"Not Pending","title":"Check ASCII Palindromic","memory":"45.2 MB","code":"class Solution {\\n    public boolean isPalindromic(String s) {\\n        StringBuilder bin = new StringBuilder();\\n\\n        for(char ch:s.toCharArray()) {\\n            int ascii = (int) ch;\\n            String bits = Integer.toBinaryString(ascii);\\n\\n            while(bits.length()<8) {\\n                bits=\\"0\\"+bits;\\n            }\\n            bin.append(bits);\\n        }\\n        int left = 0;\\n        int right=bin.length()-1;\\n\\n        while(left<right) {\\n            if(bin.charAt(left)!=bin.charAt(right)) {\\n                return false;\\n            }\\n            left++;\\n            right--;\\n        }\\n        return true;\\n    }\\n}","compare_result":"","title_slug":"check-ascii-palindromic","has_notes":false,"flag_type":1,"frontend_id":621},{"id":2115764996,"question_id":2694,"lang":"java","lang_name":"Java","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1787378487,"status":10,"status_display":"Accepted","runtime":"178 ms","url":"/submissions/detail/2115764996/","is_pending":"Not Pending","title":"Find the Maximum Divisibility Score","memory":"47.7 MB","code":"class Solution {\\n    public int maxDivScore(int[] nums, int[] divisors) {\\n        int min = Integer.MAX_VALUE;\\n        int max = 0;\\n        for(int i=0;i<divisors.length;i++) {\\n            int count=0;\\n            for(int j=0;j<nums.length;j++) {\\n                if(nums[j]%divisors[i]==0) {\\n                    count++;\\n                }\\n            }\\n            if(count > max) {\\n                max = count;\\n                min = divisors[i];\\n            } else if (count == max) {\\n                min = Math.min(min, divisors[i]);\\n            }\\n        }\\n        return min;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-the-maximum-divisibility-score","has_notes":false,"flag_type":