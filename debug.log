lic int numSquares(int n) {\\n        int dp[] = new int[n+1];\\n        for(int i=1;i<=n;i++) {\\n            dp[i]=i;\\n            \\n            for(int j=1;j*j<=i;j++) {\\n                dp[i] = Math.min(dp[i],dp[i-j*j]+1);\\n            }\\n        }\\n        return dp[n];\\n    }\\n}","compare_result":"","title_slug":"perfect-squares","has_notes":false,"flag_type":1,"frontend_id":490},{"id":2046756877,"question_id":343,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782473073,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2046756877/","is_pending":"Not Pending","title":"Integer Break","memory":"42.3 MB","code":"class Solution {\\n    public int integerBreak(int n) {\\n        if(n<=3) return n-1;\\n        int pr = 1;\\n        while(n>4) {\\n            pr *= 3;\\n            n -= 3; \\n        }\\n        return pr*n;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111","title_slug":"integer-break","has_notes":false,"flag_type":1,"frontend_id":489},{"id":2046753491,"question_id":319,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782472846,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2046753491/","is_pending":"Not Pending","title":"Bulb Switcher","memory":"42.2 MB","code":"class Solution {\\n    public int bulbSwitch(int n) {\\n         return (int) Math.sqrt(n);\\n    }\\n}","compare_result":"11111111111111111111111111111111111","title_slug":"bulb-switcher","has_notes":false,"flag_type":1,"frontend_id":488},{"id":2045885889,"question_id":151,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1782398204,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2045885889/","is_pending":"Not Pending","title":"Reverse Words in a String","memory":"44.2 MB","code":"class Solution {\\n    public String reverseWords(String 