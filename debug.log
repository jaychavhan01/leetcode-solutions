2026-10-05 18:52:32,822 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":2074780689,"question_id":1386,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1784563253,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2074780689/","is_pending":"Not Pending","title":"Shift 2D Grid","memory":"47.2 MB","code":"class Solution {\\n    public List<List<Integer>> shiftGrid(int[][] grid, int k) {\\n        int m = grid.length;\\n        int n = grid[0].length;\\n        int tot = m*n;\\n        k = k%tot;\\n\\n        List<List<Integer>> res = new ArrayList<>();\\n        for(int i=0;i<m;i++) {\\n            List<Integer> row = new ArrayList<>();\\n            for(int j=0;j<n;j++) {\\n                row.add(0);\\n            }\\n            res.add(row);\\n        }\\n\\n        for(int i=0;i<m;i++) {\\n            for(int j=0;j<n;j++) {\\n                int oind = i*n+j;\\n                int nind = (oind+k)%tot;\\n                int nrow = nind/n;\\n                int ncol = nind%n;\\n                res.get(nrow).set(ncol,grid[i][j]);\\n            }\\n        }\\n        return res;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"shift-2d-grid","has_notes":false,"flag_type":1,"frontend_id":545},{"id":2073703727,"question_id":577,"lang":"mysql","lang_name":"MySQL","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1784479655,"status":10,"status_display":"Accepted","runtime":"870 ms","url":"/submissions/detail/2073703727/","is_pending":"Not Pending","title":"Employee Bonus","memory":"0.0B","code":"# Write your MySQL query statement below\\nSELECT e.name, b.bonus\\nFROM Employee e\\nLEFT JOIN Bonus b\\nON e.empId = b.empId\\nWHERE b.bonus < 1000\\n   OR b.bonus IS NULL;","compare_result":"111111111111111111111","title_slug":"employee-bonus","has_notes":false,"flag_type":1,"frontend_id":544},{