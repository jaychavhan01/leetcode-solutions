ightsum[i]);\\n        }\\n        return res;\\n    }\\n}","compare_result":"11111111111111111111111111111111111111111111111111111","title_slug":"left-and-right-sum-differences","has_notes":false,"flag_type":1,"frontend_id":404},{"id":2023440708,"question_id":9,"lang":"java","lang_name":"Java","time":"3\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1780675552,"status":10,"status_display":"Accepted","runtime":"5 ms","url":"/submissions/detail/2023440708/","is_pending":"Not Pending","title":"Palindrome Number","memory":"46.1 MB","code":"class Solution {\\n    public boolean isPalindrome(int x) {\\n        if (x<0) return false;\\n        int num = x;\\n        int sum = 0;\\n        while(num>0) {\\n            sum = (sum*10) + (num%10);\\n            num /= 10;\\n        }\\n        return sum==x;\\n    }\\n}","compare_result":"","title_slug":"palindrome-number","has_notes":false,"flag_type":1,"frontend_id":403},{"id":2022321775,"question_id":4057,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months","timestamp":1780579670,"status":10,"status_display":"Accepted","runtime":"31 ms","url":"/submissions/detail/2022321775/","is_pending":"Not Pending","title":"Total Waviness of Numbers in Range I","memory":"46.6 MB","code":"class Solution {\\n    public int totalWaviness(int num1, int num2) {\\n        int ans = 0;\\n\\n        for (int num = num1; num <= num2; num++) {\\n            ans += waviness(num);\\n        }\\n\\n        return ans;\\n    }\\n\\n    private int waviness(int num) {\\n        String s = String.valueOf(num);\\n\\n        if (s.length() < 3) return 0;\\n\\n        int count = 0;\\n\\n        for (int i = 1; i < s.length() - 1; i++) {\\n            char prev = s.charAt(i - 1);\\n            char curr = s.charAt(i);\\n            char next = s.charAt(i + 1);\\n\\n            if (curr > prev && curr > next) count++;\\n            else if (curr < prev && curr < next) count++;\\n        }\\n\\n        return count;\\n    }\\n}","compare_result":"","title_slug":"total-waviness-of-numbers-in-range-i","has_notes":false,"flag_type":1,"frontend_id":402},{"id":2022321267,"question_id":4057,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months","timestamp":1780579632,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2022321267/","is_pending":"Not Pending","title":"Total Waviness of Numbers in Range I","memory":"N/A","code":"class Solution {\\n    public int totalWaviness(int num1, int num2) {\\n        int ans = 0;\\n\\n        for (int num = num1; num <= num2; num++) {\\n            String s = String.valueOf(num);\\n\\n        if (s.length() < 3) return 0;\\n\\n        for (int i = 1; i < s.length() - 1; i++) {\\n            char prev = s.charAt(i - 1);\\n            char curr = s.charAt(i);\\n            char next = s.charAt(i + 1);\\n\\n            if (curr > prev && curr > next) ans++;\\n            else if (curr < prev && curr < next) ans++;\\n        }\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"total-waviness-of-numbers-in-range-i","has_notes":false,"flag_type":1,"frontend_id":401},{"id":2021471086,"question_id":8,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months","timestamp":1780505643,"status":10,"status_display":"Accepted","runtime":"1 ms","url":"/submissions/detail/2021471086/","is_pending":"Not Pending","title":"String to Integer (atoi)","memory":"44.1 MB","code":"class Solution {\\n    public int myAtoi(String s) {\\n        s = s.trim();\\n\\n        if (s.length() == 0)\\n            return 0;\\n\\n        int sign = 1, i = 0;\\n        long num = 0;\\n\\n        if (s.charAt(0) == \'-\') {\\n            sign = -1;\\n            i++;\\n        } else if (s.charAt(0) == \'+\') {\\n            i++;\\n        }\\n\\n        while (i < s.length() && Character.isDigit(s.charAt(i))) {\\n            num = num * 10 + (s.charAt(i) - \'0\');\\n\\n            if (sign * num > Integer.MAX_VALUE)\\n                return Integer.MAX_VALUE;\\n\\n            if (sign * num < Integer.MIN_VALUE)\\n                return Integer.MIN_VALUE;\\n\\n            i++;\\n        }\\n\\n        return (int) (sign * num);\\n    }\\n}","compare_result":"","title_slug":"string-to-integer-atoi","has_notes":false,"flag_type":1,"frontend_id":400},{"id":2020079840,"question_id":3965,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months","timestamp":1780396942,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2020079840/","is_pending":"Not Pending","title":"Earliest Finish Time for Land and Water Rides I","memory":"46.9 MB","code":"class Solution {\\n    public int earliestFinishTime(int[] landStartTime, int[] landDuration,\\n                                  int[] waterStartTime, int[] waterDuration) {\\n\\n        int ans = Integer.MAX_VALUE;\\n\\n        for (int i = 0; i < landStartTime.length; i++) {\\n            for (int j = 0; j < waterStartTime.length; j++) {\\n\\n                // Land -> Water\\n                int landFinish = landStartTime[i] + landDuration[i];\\n                int waterBegin = Math.max(landFinish, waterStartTime[j]);\\n                ans = Math.min(ans, waterBegin + waterDuration[j]);\\n\\n                // Water -> Land\\n                int waterFinish = waterStartTime[j] + waterDuration[j];\\n                int landBegin = Math.max(waterFinish, landStartTime[i]);\\n                ans = Math.min(ans, landBegin + landDuration[i]);\\n            }\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"","title_slug":"earliest-finish-time-for-land-and-water-rides-i","has_notes":false,"flag_type":1,"frontend_id":399},{"id":2019449527,"question_id":1019,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months","timestamp":1780338508,"status":10,"status_display":"Accepted","runtime":"10 ms","url":"/submissions/detail/2019449527/","is_pending":"Not Pending","title":"Squares of a Sorted Array","memory":"47.6 MB","code":"class Solution {\