:"/submissions/detail/2012528683/","is_pending":"Not Pending","title":"Diagonal Traverse","memory":"47.8 MB","code":"class Solution {\\n    public int[] findDiagonalOrder(int[][] mat) {\\n\\n        int m = mat.length;\\n        int n = mat[0].length;\\n\\n        int[] ans = new int[m * n];\\n        int ind = 0;\\n\\n        for (int d = 0; d < m + n - 1; d++) {\\n\\n            // EVEN diagonal -> upward\\n            if (d % 2 == 0) {\\n\\n                int r = Math.min(d, m - 1);\\n                int c = d - r;\\n\\n                while (r >= 0 && c < n) {\\n                    ans[ind++] = mat[r][c];\\n                    r--;\\n                    c++;\\n                }\\n            }\\n\\n            // ODD diagonal -> downward\\n            else {\\n\\n                int c = Math.min(d, n - 1);\\n                int r = d - c;\\n\\n                while (c >= 0 && r < m) {\\n                    ans[ind++] = mat[r][c];\\n                    r++;\\n                    c--;\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n}","compare_result":"111111111111111111111111111111111","title_slug":"diagonal-traverse","has_notes":false,"flag_type":1,"frontend_id":362},{"id":2012496464,"question_id":74,"lang":"java","lang_name":"Java","time":"4\xc2\xa0months, 1\xc2\xa0week","timestamp":1779704018,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2012496464/","is_pending":"Not Pending","title":"Search a 2D Matrix","memory":"44.2 MB","code":"class Solution {\\n    public boolean searchMatrix(int[][] matrix, int target) {\\n        int j=matrix[0].length-1;\\n        int i=0;\\n        while(j>=0 && i<matrix.length) {\\n            if(matrix[i][j]==target) return true;\\n            else if(matrix[i][j]>target) {\\n                j--;\\n            }\\n            else {\\n                i++;\\n            }\\n        }\\n        return false;\\n    }\\n}","compare_result":"1111111111111111111111