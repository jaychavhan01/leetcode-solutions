2026-10-05 18:52:40,176 [DEBUG] leetcode.py:152 - b'{"submissions_dump":[{"id":2064993978,"question_id":1256,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783860560,"status":10,"status_display":"Accepted","runtime":"38 ms","url":"/submissions/detail/2064993978/","is_pending":"Not Pending","title":"Rank Transform of an Array","memory":"77.1 MB","code":"class Solution {\\n    public int[] arrayRankTransform(int[] arr) {\\n        int[] copy = arr.clone(); \\n        Arrays.sort(copy);\\n        \\n        HashMap<Integer,Integer> rmap = new HashMap<>();\\n        int rank = 1;\\n        for(int num:copy) {\\n            if(!rmap.containsKey(num)) {\\n                rmap.put(num,rank);\\n                rank++;\\n            }\\n        }\\n        for(int i=0;i<arr.length;i++) {\\n            arr[i] = rmap.get(arr[i]);\\n        }\\n        return arr;\\n    }\\n}","compare_result":"1111111111111111111111111111111111111111111","title_slug":"rank-transform-of-an-array","has_notes":false,"flag_type":1,"frontend_id":525},{"id":2064040042,"question_id":13,"lang":"java","lang_name":"Java","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1783785736,"status":10,"status_display":"Accepted","runtime":"2 ms","url":"/submissions/detail/2064040042/","is_pending":"Not Pending","title":"Roman to Integer","memory":"46.3 MB","code":"class Solution {\\n    public int romanToInt(String s) {\\n         int tot=0;\\n         int prev = 0;\\n         for(int i=s.length()-1;i>=0;i--) {\\n            int curr = getValue(s.charAt(i));\\n            if(curr<prev)\\n                tot -= curr;\\n            else\\n                tot += curr;\\n            prev = curr;\\n         }\\n         return tot;\\n    }\\n    private int getValue(char c) {\\n        switch(c) {\\n            case \'I\':return 1;\\n            case \'V\':return 5;\\n            case \'X\':return 10;\\n            case \'L\':return 50;\\n            case \'C\':return 100;\\